<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Midnight Club L.A. Recompiled" Width="1220" Height="850" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0B1016" Foreground="#EDF3FA" FontFamily="Segoe UI" TextElement.FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Control"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="#0B1016"/><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#344454" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="Accent" Color="#38DBC1"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#1A232E"/><Setter Property="Foreground" Value="#EDF3FA"/><Setter Property="BorderBrush" Value="#303D4B"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#38DBC1"/><Setter Property="Foreground" Value="#091510"/><Setter Property="BorderBrush" Value="#38DBC1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F151E"/><Setter Property="Foreground" Value="#F1F5FA"/><Setter Property="BorderBrush" Value="#344252"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#38DBC1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EAF1F8"/><Setter Property="Background" Value="#19232F"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.FontFamily="Segoe UI"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#2A4050"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EAF1F8"/><Setter Property="Background" Value="#111923"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="#EAF1F8" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#111923" BorderBrush="#344252" BorderThickness="1" CornerRadius="6"><Grid><ContentPresenter TextElement.FontFamily="Segoe UI" Margin="12,9,32,9" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#38DBC1"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#19232F" BorderBrush="#344252" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="350"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF1F8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#354251"><Border x:Name="Thumb" Width="18" Height="18" Margin="3" CornerRadius="9" Background="#B3BFCA" HorizontalAlignment="Left"/></Border><ContentPresenter TextElement.FontFamily="Segoe UI" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#38DBC1"/><Setter TargetName="Thumb" Property="Background" Value="#0B211A"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#9EAEBF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="BG" CornerRadius="8" Background="Transparent" Padding="17,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Tag}" FontSize="16"/><ContentPresenter TextElement.FontFamily="Segoe UI" Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="BG" Property="Background" Value="#1B2B36"/><Setter Property="Foreground" Value="#5DE7CE"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BG" Property="Background" Value="#17212D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141C26"/><Setter Property="BorderBrush" Value="#283544"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#94A5B8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#0D131B" BorderBrush="#222D39" BorderThickness="0,0,1,0"><DockPanel Margin="16,24">
  <StackPanel DockPanel.Dock="Top" Margin="8,0,0,26"><Image x:Name="SideLogo" Height="61" Stretch="Uniform"/><TextBlock Text="L.A. RECOMPILED" Foreground="#38DBC1" FontSize="10" FontWeight="Bold" Margin="5,12,0,0"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="11,0,0,0"><TextBlock Text="PORTUGUÊS · BRASIL" Foreground="#5DE7CE" FontSize="10" FontWeight="Bold"/><TextBlock Text="Por Araujo" Margin="0,9,0,0" Foreground="#74869A" FontSize="11"/><TextBlock Text="Midnight Club: Los Angeles" Margin="0,5,0,0" Foreground="#74869A" FontSize="10"/></StackPanel>
  <StackPanel x:Name="Navigation"><RadioButton x:Name="NavHome" Content="Jogar" Tag="▷" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True"/><RadioButton x:Name="NavGraphics" Content="Gráficos" Tag="☷" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavProfile" Content="Perfil e controles" Tag="◎" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavSaves" Content="Saves e dados" Tag="▣" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavLogs" Content="Registro" Tag="≡" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavCredits" Content="Créditos" Tag="◇" Style="{StaticResource Nav}" GroupName="Nav"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1" Margin="32,28,32,70">
  <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="14" ClipToBounds="True" Background="#17222C" Margin="0,0,18,0" Height="255"><Grid><Image x:Name="HeroArt" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#180A1016" Offset="0"/><GradientStop Color="#F0091018" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="23"><TextBlock Text="LOS ANGELES." FontSize="34" FontWeight="Black"/><TextBlock Text="DO SEU JEITO." FontSize="29" FontWeight="Black" Foreground="#5DE7CE"/><TextBlock Text="Tradução PT-BR · Ultrawide · AMD FidelityFX" Margin="0,13,0,0" FontSize="11" Foreground="#C9D5E0"/></StackPanel></Grid></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="PRONTO PARA A RUA?" FontWeight="Bold" Foreground="#94A5B8" FontSize="11"/><TextBlock x:Name="InstallStatus" Text="Prepare seu jogo" FontSize="23" FontWeight="Bold" Margin="0,14,0,14" TextWrapping="Wrap"/><Button x:Name="PlayButton" Content="JOGAR" Style="{StaticResource Primary}" FontSize="20" Padding="16,13" IsEnabled="False"/><Button x:Name="LocateButton" Content="Localizar instalação" Margin="0,12,0,0"/><TextBlock x:Name="HomeActionHint" Text="Sua ISO será necessária apenas na preparação." Style="{StaticResource Hint}" FontSize="11" Margin="0,11,0,0"/></StackPanel></Border>
   </Grid>
   <TextBlock Text="SUA INSTALAÇÃO" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="IsoLabel" Text="Arquivo ISO" FontWeight="SemiBold"/><Grid x:Name="IsoRow" Margin="0,10,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="IsoPath" Margin="0,0,12,0"/><Button x:Name="BrowseIso" Content="Procurar ISO…" Grid.Column="1"/></Grid><TextBlock Text="Pasta do jogo" FontWeight="SemiBold"/><Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="InstallPath" Margin="0,0,12,0"/><Button x:Name="BrowseInstall" Content="Escolher pasta…" Grid.Column="1"/></Grid><TextBlock Text="Escolha uma subpasta. Você pode editar o caminho e o nome; não use a própria pasta do instalador." Style="{StaticResource Hint}" FontSize="11"/><CheckBox x:Name="DesktopShortcut" Content="Criar atalho na Área de Trabalho para jogar diretamente" IsChecked="True" Margin="0,20,0,19"/><WrapPanel><Button x:Name="PrepareButton" Content="PREPARAR MEU JOGO" Style="{StaticResource Primary}" Margin="0,0,12,0"/><Button x:Name="OpenGameFolder" Content="Abrir pasta"/></WrapPanel></StackPanel></Border>
   <Border Background="#111E23" CornerRadius="9" Padding="16" Margin="0,18,0,0"><TextBlock x:Name="HomeInfo" Text="Use sua própria ISO de Midnight Club: Los Angeles Complete Edition para Xbox 360." Style="{StaticResource Hint}" FontSize="12"/></Border>
  </StackPanel></ScrollViewer>
  <Grid x:Name="PageGraphics" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="GRÁFICOS" Style="{StaticResource Heading}"/><TextBlock Text="Escolha um perfil ou ajuste cada opção. As mudanças valem na próxima abertura do jogo." Style="{StaticResource Hint}" Margin="0,0,0,22"/>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PresetLight" HorizontalContentAlignment="Left" Margin="0,0,10,0"><StackPanel><TextBlock Text="MAIS DESEMPENHO" FontWeight="Bold" Foreground="#5DE7CE"/><TextBlock Text="Menos sombras e efeitos.&#10;FSR em Desempenho." Foreground="#9BAABD" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button><Button x:Name="PresetBalanced" Grid.Column="1" Margin="0,0,10,0"><StackPanel><TextBlock Text="EQUILIBRADO" FontWeight="Bold" Foreground="#5DE7CE"/><TextBlock Text="1440p de renderização.&#10;FSR em Qualidade." Foreground="#9BAABD" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button><Button x:Name="PresetNative" Grid.Column="2"><StackPanel><TextBlock Text="NATIVE AA" FontWeight="Bold" Foreground="#5DE7CE"/><TextBlock Text="Sem redução pelo FSR.&#10;Maior custo de GPU." Foreground="#9BAABD" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button></Grid>
   <TextBlock x:Name="PresetLabel" Text="Perfil: Equilibrado" Foreground="#5DE7CE" Margin="0,0,0,16"/><StackPanel x:Name="GraphicsGroups"/>
   </StackPanel></ScrollViewer><Button x:Name="ApplyGraphics" Grid.Row="1" Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid>
  <ScrollViewer x:Name="PageProfile" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PERFIL E CONTROLES" Style="{StaticResource Heading}"/><TextBlock Text="Sua identidade nas ruas de Los Angeles." Style="{StaticResource Hint}" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NOME DO JOGADOR" FontWeight="Bold" Margin="0,0,0,12"/><TextBox x:Name="PlayerName" Text="User" MaxLength="15" MaxWidth="480" HorizontalAlignment="Left" MinWidth="320"/><TextBlock Text="Até 15 letras sem acento, números, espaço ou sublinhado. Ao mudar o nome de um perfil existente, os saves antigos continuam preservados na pasta anterior." Style="{StaticResource Hint}" Margin="0,13,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,24"><StackPanel><TextBlock Text="ÍCONES DOS BOTÕES" FontWeight="Bold" Margin="0,0,0,12"/><ComboBox x:Name="ButtonPrompts" HorizontalAlignment="Left" MinWidth="320"><ComboBoxItem Content="Xbox" Tag="xbox"/><ComboBoxItem Content="PlayStation" Tag="playstation"/><ComboBoxItem Content="Automático" Tag="auto"/></ComboBox><TextBlock Text="Xbox é o padrão. Você também pode trocar pelo menu do jogo." Style="{StaticResource Hint}" Margin="0,13,0,0"/></StackPanel></Border><Button x:Name="ApplyProfile" Content="SALVAR PERFIL E CONTROLES" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
  <ScrollViewer x:Name="PageSaves" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SAVES E DADOS" Style="{StaticResource Heading}"/><TextBlock Text="Mantenha uma cópia do seu progresso antes de mover ou atualizar o jogo." Style="{StaticResource Hint}" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PASTA DOS DADOS" FontWeight="Bold" Foreground="#5DE7CE"/><TextBlock x:Name="SavePath" Text="Prepare ou localize uma instalação." TextWrapping="Wrap" Margin="0,15,0,10"/><TextBlock x:Name="SaveSummary" Style="{StaticResource Hint}"/><WrapPanel Margin="0,19,0,0"><Button x:Name="OpenSaves" Content="Abrir pasta dos dados" Margin="0,0,12,0"/><Button x:Name="BackupSaves" Content="Exportar backup .zip" Style="{StaticResource Primary}"/></WrapPanel></StackPanel></Border><TextBlock Text="O backup copia seus dados; não apaga nem substitui os saves. Feche o jogo antes de exportar para incluir arquivos completos." Style="{StaticResource Hint}" Margin="0,18,0,0"/></StackPanel></ScrollViewer>
  <Grid x:Name="PageLogs" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="REGISTRO" Style="{StaticResource Heading}"/><TextBlock Text="Acompanhe a preparação e copie as mensagens se precisar de ajuda." Style="{StaticResource Hint}" Grid.Row="1" Margin="0,0,0,20"/><TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="CopyLogs" Content="Copiar registro" Margin="0,0,12,0"/><Button x:Name="OpenLogs" Content="Abrir logs do jogo"/></WrapPanel></Grid>
  <ScrollViewer x:Name="PageCredits" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="CRÉDITOS" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="MIDNIGHT CLUB L.A. RECOMPILED" FontWeight="Bold" Foreground="#5DE7CE" FontSize="19"/><TextBlock Text="Melhorias e tradução: Araujo" Margin="0,23,0,12"/><TextBlock Text="Base da recompilação: holdmysocks / RenanQueiroz" Margin="0,0,0,12"/><TextBlock Text="Runtime e ferramentas: ReXGlue" Margin="0,0,0,12"/><TextBlock Text="Tecnologia gráfica: AMD FidelityFX" Margin="0,0,0,22"/><TextBlock Text="Midnight Club: Los Angeles e suas marcas pertencem aos respectivos titulares. Nenhum dado do jogo é fornecido pelo instalador. O logo original é preservado dentro do jogo." Style="{StaticResource Hint}"/><Button x:Name="OpenLicenses" Content="Abrir créditos e licenças" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
 </Grid>
 <Border Grid.Column="1" VerticalAlignment="Bottom" Background="#121B25" BorderBrush="#263442" BorderThickness="0,1,0,0" Padding="20,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Escolha sua ISO ou localize uma instalação pronta." Foreground="#A5B6C8" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#38DBC1" Background="#293745"/></Grid></Border>
 </Grid>
</Window>
