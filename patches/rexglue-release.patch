+  std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, kGeneratedCount> generated;
+  std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, kGeneratedCount> generated_display;
+  uint32_t generated_width = 0;
+  uint32_t generated_height = 0;
+  uint32_t generated_display_width = 0;
