diff --git a/src/graphics/vulkan/fsr_mode_texture.inc b/src/graphics/vulkan/fsr_mode_texture.inc
new file mode 100644
index 0000000..4efb772
--- /dev/null
+++ b/src/graphics/vulkan/fsr_mode_texture.inc
@@ -0,0 +1,70 @@
+// Included inside the VulkanTextureCache implementation's namespace.
+bool VulkanTextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                                               bool load_mips) {
+  if (!LoadTextureDataRaw(texture, load_base, load_mips)) return false;
+  return !load_base || ExpandReducedScene(texture);
+}
+
+// Expand cropped resolves for the game's existing screen-space texture consumers.
+bool VulkanTextureCache::ExpandReducedScene(Texture& base_texture) {
+  auto& texture = static_cast<VulkanTexture&>(base_texture);
+  const auto& key = texture.key();
+  const auto found = reduced_scene_pages_.find(key.base_page);
+  if (found == reduced_scene_pages_.end() || key.GetWidth() != 1280 || key.GetHeight() != 720 ||
+      key.mip_max_level || key.depth_or_array_size_minus_1) return true;
+  const float fraction = found->second;
+  static uint32_t logged_formats = 0;
+  const auto format_bit = 1u << (uint32_t(texture.image_format()) % 31);
+  if (!(logged_formats & format_bit)) {
+    logged_formats |= format_bit;
+    REXGPU_INFO("FSR modes: expanding cropped scene resolve format {} at page {:X}",
+                 uint32_t(texture.image_format()), uint32_t(key.base_page));
+  }
+  const uint32_t width = key.GetWidth() * (key.scaled_resolve ? draw_resolution_scale_x() : 1);
+  const uint32_t height = key.GetHeight() * (key.scaled_resolve ? draw_resolution_scale_y() : 1);
+  const auto format = texture.image_format();
+  const uint64_t scratch_key = (uint64_t(format) << 32) | (uint64_t(width) << 16) | height;
+  auto& scratch = scene_expand_scratch_[scratch_key];
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& functions = device->functions();
+  if (scratch.image == VK_NULL_HANDLE) {
+    VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    info.imageType = VK_IMAGE_TYPE_2D; info.format = format;
+    info.extent = {width, height, 1}; info.mipLevels = info.arrayLayers = 1;
+    info.samples = VK_SAMPLE_COUNT_1_BIT; info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    VmaAllocationCreateInfo allocation{}; allocation.usage = VMA_MEMORY_USAGE_GPU_ONLY;
+    if (vmaCreateImage(vma_allocator_, &info, &allocation, &scratch.image,
+                       &scratch.allocation, nullptr) != VK_SUCCESS) {
+      REXGPU_ERROR("FSR modes: cannot allocate the scene expansion surface"); return false;
+    }
+  }
+  command_processor_.EndRenderPass();
+  VkPipelineStageFlags old_stage; VkAccessFlags old_access; VkImageLayout old_layout;
+  GetTextureUsageMasks(texture.SetUsage(VulkanTexture::Usage::kTransferDestination),
+                       old_stage, old_access, old_layout);
+  const auto range = ui::vulkan::util::InitializeSubresourceRange();
+  command_processor_.PushImageMemoryBarrier(texture.image(), range, old_stage,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, old_access, VK_ACCESS_TRANSFER_READ_BIT,
+      old_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.PushImageMemoryBarrier(scratch.image, range,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  auto& commands = command_processor_.deferred_command_buffer();
+  RecordFsrModeBlit(commands, functions.vkCmdBlitImage, texture.image(), scratch.image,
+      uint32_t(std::ceil(width * fraction)), uint32_t(std::ceil(height * fraction)), width, height);
+  command_processor_.PushImageMemoryBarrier(scratch.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.PushImageMemoryBarrier(texture.image(), range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkImageCopy copy{}; copy.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  copy.dstSubresource = copy.srcSubresource; copy.extent = {width, height, 1};
+  commands.CmdVkCopyImage(scratch.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                          texture.image(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, copy);
+  return true;
+}
