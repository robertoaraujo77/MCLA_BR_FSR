+        break;
+      case VK_IMAGE_LAYOUT_GENERAL:
+        stage_mask = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+        access_mask = VK_ACCESS_SHADER_WRITE_BIT;
+        break;
+      default:
+        stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+        access_mask = 0;
+        break;
+    }
+  };
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  usage(image.layout, src_stage_mask, src_access_mask);
+  usage(layout, dst_stage_mask, dst_access_mask);
+  PushImageMemoryBarrier(image.image, ui::vulkan::util::InitializeSubresourceRange(),
+                         src_stage_mask, dst_stage_mask, src_access_mask, dst_access_mask,
+                         image.layout, layout);
+  image.layout = layout;
+}
+
+bool VulkanCommandProcessor::HdrRenderScene(const VulkanShader& vertex_shader,
+                                            const VulkanShader& pixel_shader) {
+  HdrImage* scene = HdrGetImage(kHdrTextureScene);
+  if (!scene || hdr_scene_pipeline_ == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorImageInfo textures[4];
+  for (uint32_t i = 0; i < 4; ++i) {
+    textures[i] = {VK_NULL_HANDLE, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    for (const VulkanShader::TextureBinding& binding :
+         (i < 3 ? pixel_shader : vertex_shader).GetTextureBindingsAfterTranslation()) {
+      if (binding.fetch_constant == kHdrSceneFetchConstants[i]) {
+        textures[i].imageView = texture_cache_->GetActiveBindingOrNullImageView(
+            binding.fetch_constant, binding.dimension, bool(binding.is_signed));
+      }
+    }
+    if (textures[i].imageView == VK_NULL_HANDLE) {
+      return false;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  uint32_t frame_index = uint32_t(frame_current_ % kMaxFramesInFlight);
+  VkDescriptorImageInfo output = {VK_NULL_HANDLE, scene->view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = i ? hdr_descriptors_scene_output_[frame_index]
+                         : hdr_descriptors_scene_textures_[frame_index];
+    writes[i].descriptorCount = i ? 1 : 4;
+    writes[i].descriptorType = i ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = i ? &output : textures;
+  }
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0, nullptr);
+  EndRenderPass();
+  HdrTransitionImage(*scene, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  // The game's textures were made visible to the guest shader stages.
+  VkMemoryBarrier memory_barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, 0,
+                                    VK_ACCESS_SHADER_READ_BIT};
+  deferred_command_buffer_.CmdVkPipelineBarrier(guest_shader_pipeline_stages_,
+                                                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1,
+                                                &memory_barrier, 0, nullptr, 0, nullptr);
+  BindExternalComputePipeline(hdr_scene_pipeline_);
+  VkDescriptorSet sets[2] = {hdr_descriptors_scene_textures_[frame_index],
+                             hdr_descriptors_scene_output_[frame_index]};
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_COMPUTE, hdr_scene_pipeline_layout_, 0, 2, sets, 0, nullptr);
+  deferred_command_buffer_.CmdVkPushConstants(hdr_scene_pipeline_layout_,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                              sizeof(HdrSceneConstants), &hdr_scene_constants_);
+  deferred_command_buffer_.CmdVkDispatch((hdr_output_width_ + 15) / 16,
+                                         (hdr_output_height_ + 7) / 8, 1);
+  HdrTransitionImage(*scene, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  return true;
+}
