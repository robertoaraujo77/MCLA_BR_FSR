-#ifdef __APPLE__
-// Apple libc++ does not expose clock_time_conversion or clock_cast.
+#if defined(__APPLE__) || defined(__PROSPERO__) || defined(__FreeBSD__)
+// Apple libc++ does not expose clock_time_conversion or clock_cast, and
+// neither does the libc++ shipped with the PS5 payload SDK.
 template <class, class>
