+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> view_heap;
+  // The proxy's real buffer for each callback (generated, real), written at
+  // the callback (RTVs are read when bound).
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> rtv_heap;
+
+  // For the generation callback, inside the proxy's Present on the painting
+  // thread.
+  FrameGenerationInputs* current_inputs = nullptr;
+  uint64_t current_frame_id = 0;
+  bool current_generate = false;
+  bool current_reset = false;
+
+  // Each failure logged once.
+  bool prepare_failure_logged = false;
+  bool configure_failure_logged = false;
+  bool dispatch_failure_logged = false;
+  // The present interval last logged (UINT32_MAX: none yet), and the
+  // tearing choice taken at connection (frame_generation_present, read on the
+  // UI thread).
+  uint32_t logged_sync_interval = UINT32_MAX;
+  bool tearing = false;
+  // Guest frames in a row painted without generation; after many, the context
+  // (hundreds of MB at 4K) is released until generation can run again.
+  uint32_t frames_without_generation = 0;
+  // Development (frame_generation_timing): GPU timestamps around generation
+  // and its compose, per frame ID % kTimingSlots, read back two frames later.
+  static constexpr uint32_t kTimingSlots = 4;
+  Microsoft::WRL::ComPtr<ID3D12QueryHeap> timing_heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> timing_readback;
