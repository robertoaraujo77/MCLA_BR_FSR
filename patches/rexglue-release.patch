+  state.test_pattern = REXCVAR_GET(hdr_test_pattern);
+  state.debug_ui = uint32_t(REXCVAR_GET(hdr_debug_ui));
+  return state;
+}
+
+Presenter::HdrDisplayInfo Presenter::GetLastHdrDisplayInfo() {
+  std::lock_guard<std::mutex> lock(hdr_display_mutex);
+  return hdr_display_info;
+}
+
+Presenter::HdrAutoLevels Presenter::GetHdrAutoLevels() {
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  // Also not NaN (a comparison with NaN is false).
+  HdrAutoLevels levels;
+  levels.peak_nits = info.peak_nits >= 80.0f && info.peak_nits <= 10000.0f ? info.peak_nits
+                                                                           : 1000.0f;
+  levels.paper_white_nits =
+      info.sdr_white_nits >= 40.0f && info.sdr_white_nits <= 10000.0f ? info.sdr_white_nits
+                                                                       : 200.0f;
+  return levels;
+}
+
+bool Presenter::IsHdrOutputActive() { return hdr_output_active.load(std::memory_order_acquire); }
+
+void Presenter::SetHdrOutputActive(bool active) {
+  if (hdr_output_active.exchange(active, std::memory_order_acq_rel) != active) {
+    REXLOG_INFO("Presenter: HDR output (HDR10) {}", active ? "on" : "off");
+  }
+}
+
+// What the display reports, on a thread of its own (QueryDisplayConfig and
+// DXGI can take milliseconds), about once a second while `hdr` isn't off
+// (Windows doesn't reliably announce SDR brightness changes) and when woken
+// (another display, the platform's HDR or display events, the setting).
+class Presenter::HdrDisplayWorker {
+ public:
+  static HdrDisplayWorker& Get() {
+    static HdrDisplayWorker worker;
+    return worker;
+  }
+  void Wake() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      wake_ = true;
+    }
+    condition_.notify_all();
+  }
+  // So that the first connection already has the display's state (rather
+  // than going SDR and then switching).
+  void AwaitFirstQuery() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    queried_condition_.wait_for(lock, std::chrono::seconds(1), [this] { return queried_ != 0; });
+  }
+  // A query that starts after this call, finished (or the timeout).
+  void QueryAndWait(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    uint64_t target = queried_ + (querying_ ? 2 : 1);
+    wake_ = true;
+    condition_.notify_all();
+    queried_condition_.wait_for(lock, timeout, [this, target] { return queried_ >= target; });
+  }
+  ~HdrDisplayWorker() {
+    // A static's destructor: on Windows it runs when rexruntime is unloaded at
+    // exit, after the process's other threads were ended, so the worker may
+    // have been ended holding the lock, which is then never released. The lock
+    // is only tried, for a little while; without it the thread is left alone.
+    std::unique_lock<std::mutex> lock(mutex_, std::defer_lock);
+    for (uint32_t i = 0; i < 50 && !lock.try_lock(); ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    if (!lock.owns_lock()) {
+      if (thread_.joinable()) {
+        thread_.detach();
+      }
+      return;
+    }
+    quit_ = true;
+    lock.unlock();
+    condition_.notify_one();
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+  }
+
+ private:
+  HdrDisplayWorker() : thread_([this] { Run(); }) {}
+  void Run() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!quit_) {
+      if (wake_ || hdr_mode.load(std::memory_order_relaxed)) {
+        wake_ = false;
+        querying_ = true;
+        lock.unlock();
+        Query();
+        lock.lock();
+        querying_ = false;
+        ++queried_;
+        queried_condition_.notify_all();
+      }
+      condition_.wait_for(lock, std::chrono::seconds(1), [this] { return quit_ || wake_; });
+    }
+  }
+  void Query();
+
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  std::condition_variable queried_condition_;
+  bool wake_ = true;
+  bool quit_ = false;
+  bool querying_ = false;
+  uint64_t queried_ = 0;  // queries done
+#if REX_PLATFORM_WIN32
+  Microsoft::WRL::ComPtr<IDXGIFactory1> factory_;
+  Microsoft::WRL::ComPtr<IDXGIOutput6> output6_;
+  HMONITOR output6_monitor_ = nullptr;
+#endif
+  // Last: started once the rest is constructed.
+  std::thread thread_;
+};
+
+void Presenter::HdrDisplayWorker::Query() {
+  HdrDisplayInfo info;
+#if REX_PLATFORM_WIN32
+  // DXGI (the HDR switch, and the peak including the Windows HDR Calibration
+  // profile) and DisplayConfig (the SDR content brightness).
+  HMONITOR monitor = static_cast<HMONITOR>(hdr_monitor.load());
+  if (factory_ && !factory_->IsCurrent()) {
+    factory_.Reset();
+    output6_.Reset();
+  }
+  if (!factory_) {
+    CreateDXGIFactory1(IID_PPV_ARGS(&factory_));
+  }
+  if (output6_ && output6_monitor_ != monitor) {
+    output6_.Reset();
+  }
+  if (!output6_ && factory_ && monitor) {
+    if (Microsoft::WRL::ComPtr<IDXGIOutput> output =
+            GetDXGIOutputForMonitor(factory_.Get(), monitor)) {
+      output.As(&output6_);
+      output6_monitor_ = monitor;
+    }
+  }
+  DXGI_OUTPUT_DESC1 desc;
+  if (output6_ && SUCCEEDED(output6_->GetDesc1(&desc))) {
+    info.known = true;
+    info.hdr_enabled = desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+    info.peak_nits = desc.MaxLuminance;
+    info.full_frame_nits = desc.MaxFullFrameLuminance;
+    info.min_nits = desc.MinLuminance;
+    UINT32 path_count = 0, mode_count = 0;
+    if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count) ==
+        ERROR_SUCCESS) {
+      std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+      std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+      if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &path_count, paths.data(), &mode_count,
+                             modes.data(), nullptr) == ERROR_SUCCESS) {
+        for (UINT32 i = 0; i < path_count; ++i) {
+          DISPLAYCONFIG_SOURCE_DEVICE_NAME source = {};
+          source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+          source.header.size = sizeof(source);
+          source.header.adapterId = paths[i].sourceInfo.adapterId;
+          source.header.id = paths[i].sourceInfo.id;
+          if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS ||
+              wcscmp(source.viewGdiDeviceName, desc.DeviceName)) {
+            continue;
+          }
+          DISPLAYCONFIG_SDR_WHITE_LEVEL white = {};
+          white.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL;
+          white.header.size = sizeof(white);
+          white.header.adapterId = paths[i].targetInfo.adapterId;
+          white.header.id = paths[i].targetInfo.id;
+          if (DisplayConfigGetDeviceInfo(&white.header) == ERROR_SUCCESS) {
+            info.sdr_white_nits = float(white.SDRWhiteLevel) * (80.0f / 1000.0f);
+          }
+          break;
+        }
+      }
+    }
+  }
+#endif  // REX_PLATFORM_WIN32
+  bool changed;
+  {
+    std::lock_guard<std::mutex> lock(hdr_display_mutex);
+    changed = info.known != hdr_display_info.known ||
+              info.hdr_enabled != hdr_display_info.hdr_enabled ||
+              info.peak_nits != hdr_display_info.peak_nits ||
+              info.sdr_white_nits != hdr_display_info.sdr_white_nits;
+    hdr_display_info = info;
+  }
+  if (changed) {
+    if (info.known) {
+      REXLOG_INFO(
+          "Presenter: display HDR {}, peak {} nits, full frame {} nits, black {} nits, SDR "
+          "white {} nits",
+          info.hdr_enabled ? "on" : "off", info.peak_nits, info.full_frame_nits,
+          info.min_nits, info.sdr_white_nits);
+    } else {
+      REXLOG_INFO("Presenter: the display's HDR state is unknown");
+    }
+  }
+}
+
+void Presenter::RefreshHdrDisplayInfo(uint32_t timeout_ms) {
+  HdrDisplayWorker::Get().QueryAndWait(std::chrono::milliseconds(timeout_ms));
+}
+
+uint32_t Presenter::IsHdrOutputWanted() {
+  HdrRegisterSettingCallbacks();
+  int mode = hdr_mode.load(std::memory_order_relaxed);
+  if (!mode) {
+    return 0;
+  }
+  HdrDisplayWorker& worker = HdrDisplayWorker::Get();
+  if (hdr_display_info_stale.exchange(false)) {
+    worker.Wake();
+  }
+  static std::atomic<bool> first_query_awaited{false};
+  if (!first_query_awaited.exchange(true, std::memory_order_relaxed)) {
+    worker.AwaitFirstQuery();
+  }
+  if (!hdr_guest_output_available.load(std::memory_order_relaxed)) {
+    return 0;
+  }
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  bool display_hdr = info.known && info.hdr_enabled;
+  return display_hdr ? 2 : (mode == 2 ? 1 : 0);
+}
+
+Presenter::HdrMetadataLevels Presenter::GetHdrMetadataLevels() {
+  auto valid = [](float nits) { return std::isfinite(nits) ? std::clamp(nits, 0.0f, 10000.0f) : 0.0f; };
+  HdrOutputState state = GetHdrOutputState();
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  HdrMetadataLevels levels;
+  levels.max_nits = valid(state.peak_nits);
+  levels.max_frame_average_nits =
+      std::min(info.full_frame_nits > 0.0f ? valid(info.full_frame_nits) : levels.max_nits,
+               levels.max_nits);
+  levels.min_nits = std::min(valid(info.min_nits), levels.max_nits);
+  return levels;
+}
+
+void Presenter::SetGuestOutputHdrAvailable(bool available) {
+  if (hdr_guest_output_available.exchange(available, std::memory_order_relaxed) != available) {
+    REXLOG_INFO("Presenter: the guest output {} be HDR10 now", available ? "can" : "can't");
+  }
+}
+
+Presenter::GuestOutputCaptureConverter::GuestOutputCaptureConverter(const GuestOutputHdr& hdr)
+    : is_pq_(hdr.is_pq) {
+  if (!is_pq_) {
+    return;
+  }
+  // HDR10 code values to light relative to the SDR white level.
+  pq_to_relative_.resize(1024);
+  double white = std::max(double(hdr.sdr_white_nits), 1.0);
+  for (uint32_t i = 0; i < 1024; ++i) {
+    double e = std::pow(double(i) / 1023.0, 1.0 / 78.84375);
+    double y = std::max(e - 0.8359375, 0.0) / (18.8515625 - 18.6875 * e);
+    pq_to_relative_[i] = float(10000.0 * std::pow(y, 1.0 / 0.1593017578125) / white);
+  }
+  // Relative light to the SDR code value, inverting the curve SDR content was
+  // decoded with, indexed by the square root of the light.
+  relative_sqrt_to_code_.resize(16384);
+  for (uint32_t i = 0; i < 16384; ++i) {
+    double x = double(i) / 16383.0;
+    x *= x;
+    double code = hdr.sdr_pure_gamma_2_2
+                      ? std::pow(x, 1.0 / 2.2)
+                      : (x > 0.0031308 ? 1.055 * std::pow(x, 1.0 / 2.4) - 0.055 : 12.92 * x);
+    relative_sqrt_to_code_[i] = uint8_t(std::clamp(code * 255.0 + 0.5, 0.0, 255.0));
+  }
+}
+
+uint32_t Presenter::GuestOutputCaptureConverter::operator()(uint32_t rgb10) const {
+  if (!is_pq_) {
+    return Packed10bpcRGBTo8bpcBytes(rgb10);
+  }
+  // BT.2020 to Rec.709.
+  float r2020 = pq_to_relative_[rgb10 & 0x3FF];
+  float g2020 = pq_to_relative_[(rgb10 >> 10) & 0x3FF];
+  float b2020 = pq_to_relative_[(rgb10 >> 20) & 0x3FF];
+  float rgb[3] = {
+      std::max(1.660491f * r2020 - 0.587641f * g2020 - 0.072850f * b2020, 0.0f),
+      std::max(-0.124550f * r2020 + 1.132900f * g2020 - 0.008349f * b2020, 0.0f),
+      std::max(-0.018151f * r2020 - 0.100579f * g2020 + 1.118730f * b2020, 0.0f)};
+  float largest = std::max(rgb[0], std::max(rgb[1], rgb[2]));
+  float scale = largest > 1.0f ? 1.0f / largest : 1.0f;
+  uint32_t code[3];
+  for (uint32_t i = 0; i < 3; ++i) {
+    code[i] = relative_sqrt_to_code_[uint32_t(std::sqrt(rgb[i] * scale) * 16383.0f + 0.5f)];
+  }
+  if constexpr (std::endian::native == std::endian::big) {
+    return (code[0] << 24) | (code[1] << 16) | (code[2] << 8) | 0xFF;
+  }
+  return code[0] | (code[1] << 8) | (code[2] << 16) | (uint32_t(0xFF) << 24);
+}
