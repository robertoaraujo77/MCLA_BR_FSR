+namespace {
+// MCLA's tone map draw (hdr_scene_mcla.cs.xesl): its shaders, and its texture
+// fetch constants as the pass was written against them (2D textures, the
+// formats, signs, swizzles, edge modes and filters the game sets, no exponent
+// bias): the scene (point sampled), motion blur and bloom (bilinear), and the
+// adapted luminance (one channel, point sampled).
+constexpr uint64_t kHdrSceneVertexShader = 0x1FAB9787BCA32D7C;
+constexpr uint64_t kHdrScenePixelShader = 0xE5EBEFAE4D165CBA;
+struct HdrSceneFetch {
+  xenos::TextureFormat format;
+  uint32_t swizzle;
+  xenos::TextureFilter filter;
+};
+constexpr uint32_t kHdrSwizzleXyzw = 0 | (1 << 3) | (2 << 6) | (3 << 9);
+constexpr uint32_t kHdrSwizzleX111 = 0 | (5 << 3) | (5 << 6) | (5 << 9);
+constexpr HdrSceneFetch kHdrSceneFetches[4] = {
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kPoint},
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kLinear},
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kLinear},
+    {xenos::TextureFormat::k_32_FLOAT, kHdrSwizzleX111, xenos::TextureFilter::kPoint},
+};
+}  // namespace
+
+CommandProcessor::HdrSceneCheck CommandProcessor::HdrCheckSceneDraw() const {
+  const RegisterFile& regs = *register_file_;
+  Shader* vertex_shader = active_vertex_shader();
+  Shader* pixel_shader = active_pixel_shader();
+  if (!vertex_shader || !pixel_shader ||
+      vertex_shader->ucode_data_hash() != kHdrSceneVertexShader ||
+      pixel_shader->ucode_data_hash() != kHdrScenePixelShader) {
+    return HdrSceneCheck::kNotFound;
+  }
+  uint32_t key = HdrColorTargetKey(0);
+  if (xenos::MsaaSamples((key >> 12) & 3) != xenos::MsaaSamples::k1X ||
+      xenos::ColorRenderTargetFormat((key >> 14) & 0xF) !=
+          xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return HdrSceneCheck::kTarget;
+  }
+  // The whole output, in guest pixels: the pass writes every pixel of it from
+  // the same place in the inputs.
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  uint32_t width = hdr_output_width_ / scale_x, height = hdr_output_height_ / scale_y;
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  if (scissor.offset[0] || scissor.offset[1] || scissor.extent[0] < width ||
+      scissor.extent[1] < height) {
+    return HdrSceneCheck::kCoverage;
+  }
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable &&
+      (window_offset.window_x_offset || window_offset.window_y_offset)) {
+    return HdrSceneCheck::kCoverage;
+  }
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (!vte.vport_x_scale_ena || !vte.vport_x_offset_ena || !vte.vport_y_scale_ena ||
+      !vte.vport_y_offset_ena) {
+    return HdrSceneCheck::kCoverage;
+  }
+  float x_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+  float x_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+  float y_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+  float y_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+  // Within a pixel (the half-pixel offset).
+  if (!(x_offset - x_scale <= 1.0f && x_offset + x_scale >= float(width) - 1.0f &&
+        y_offset - y_scale <= 1.0f && y_offset + y_scale >= float(height) - 1.0f)) {
+    return HdrSceneCheck::kCoverage;
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(kHdrSceneFetchConstants[i]);
+    const HdrSceneFetch& expected = kHdrSceneFetches[i];
+    if (fetch.type != xenos::FetchConstantType::kTexture ||
+        fetch.dimension != xenos::DataDimension::k2DOrStacked || fetch.exp_adjust ||
+        fetch.format != expected.format || fetch.swizzle != expected.swizzle ||
+        fetch.sign_x != xenos::TextureSign::kSigned ||
+        fetch.sign_y != xenos::TextureSign::kSigned ||
+        fetch.sign_z != xenos::TextureSign::kSigned ||
+        fetch.sign_w != xenos::TextureSign::kSigned ||
+        fetch.clamp_x != xenos::ClampMode::kClampToEdge ||
+        fetch.clamp_y != xenos::ClampMode::kClampToEdge || fetch.mag_filter != expected.filter ||
+        fetch.min_filter != expected.filter) {
+      return HdrSceneCheck::kFetch;
+    }
+    // The scene itself at the output's size.
+    if (!i && (fetch.size_2d.width + 1 != width || fetch.size_2d.height + 1 != height)) {
+      return HdrSceneCheck::kFetch;
+    }
+  }
+  return HdrSceneCheck::kFound;
+}
+
+void CommandProcessor::HdrLogSceneCheck() {
+  if (!hdr_frame_.tonemap) {
+    return;
+  }
+  uint32_t check =
+      hdr_frame_.scene_checked ? hdr_frame_.scene_check : uint32_t(HdrSceneCheck::kNotFound);
+  if (check != hdr_last_scene_check_) {
+    hdr_last_scene_check_ = check;
+    static const char* const kReasons[] = {
+        "not wanted",
+        "no draw with its shaders before the UI",
+        "found",
+        "its render target isn't 1x 8_8_8_8",
+        "it doesn't cover the whole output (viewport, scissor or window offset)",
+        "a texture fetch constant isn't as the HDR pass reads it"};
+    static_assert(std::size(kReasons) == size_t(HdrSceneCheck::kCount));
+    if (check == uint32_t(HdrSceneCheck::kFound)) {
+      REXGPU_INFO("HDR: the tone map draw was found (vertex shader {:016X}, pixel shader {:016X}); "
+                  "the scene is in HDR",
+                  kHdrSceneVertexShader, kHdrScenePixelShader);
+    } else if (check != uint32_t(HdrSceneCheck::kOff)) {
+      REXGPU_INFO(
+          "HDR: the tone map draw (vertex shader {:016X}, pixel shader {:016X}): {} (the tone "
+          "map phase's first draw: vertex shader {:016X}, pixel shader {:016X}); frames like it "
+          "keep the 8-bit scene",
+          kHdrSceneVertexShader, kHdrScenePixelShader, kReasons[check], hdr_frame_.scene_first_vs,
+          hdr_frame_.scene_first_ps);
+    }
+  }
+  if (check == uint32_t(HdrSceneCheck::kFound) &&
+      hdr_frame_.glow_additive != hdr_last_glow_additive_) {
+    hdr_last_glow_additive_ = hdr_frame_.glow_additive;
+    if (hdr_frame_.glow_additive) {
+      REXGPU_INFO("HDR: the draws after the tone map add light again; the glows follow the "
+                  "highlights setting");
+    } else {
+      REXGPU_INFO(
+          "HDR: a draw after the tone map doesn't add light (RB_BLENDCONTROL {:08X}); frames "
+          "like it keep what was drawn after the tone map at its 8-bit level",
+          hdr_frame_.glow_other_blend);
+    }
+  }
+}
+
+CommandProcessor::HdrSceneCheck CommandProcessor::HdrPrepareScene() {
+  if (!REXCVAR_GET(mcla_hdr_scene) || !hdr_output_width_ || !REXCVAR_GET(hdr_ui_layer) ||
+      !ui::Presenter::IsHdrOutputActive() || !HdrHostRenderTargets()) {
+    return HdrSceneCheck::kOff;
+  }
+  ui::Presenter::HdrOutputState state = ui::Presenter::GetHdrOutputState();
+  // Debug views that show the frame without the scene.
+  if (state.debug_ui >= 2 && state.debug_ui <= 6) {
+    return HdrSceneCheck::kOff;
+  }
+  HdrSceneCheck check = HdrCheckSceneDraw();
+  if (check != HdrSceneCheck::kFound) {
+    return check;
+  }
+  const RegisterFile& regs = *register_file_;
+  hdr_frame_.scene_target = HdrColorTargetKey(0);
+  auto constant = [&regs](bool pixel, uint32_t index, uint32_t component) {
+    uint32_t bits = regs[(pixel ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X) +
+                         index * 4 + component];
+    float value;
+    std::memcpy(&value, &bits, sizeof(float));
+    return value;
+  };
+  HdrSceneConstants& constants = hdr_scene_constants_;
+  constants.size_mode[0] = hdr_output_width_;
+  constants.size_mode[1] = hdr_output_height_;
+  constants.size_mode[2] = uint32_t(state.debug_ui == 7);
+  // The half-pixel offset, as the host draw applies it (draw_util).
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  bool pixel_offset = REXCVAR_GET(half_pixel_offset) &&
+                      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero;
+  constants.pixel_offset[0] = pixel_offset ? 0.5f * float(scale_x) : 0.0f;
+  constants.pixel_offset[1] = pixel_offset ? 0.5f * float(scale_y) : 0.0f;
+  // Also not NaN (a comparison with NaN is false).
+  float white_squared = constant(true, 65, 0);
+  white_squared = white_squared > 1e-4f ? std::min(white_squared, 1e4f) : 1e-4f;
+  constants.curve[0] = constant(true, 64, 2);
+  constants.curve[1] = white_squared;
+  constants.curve[2] = constant(true, 255, 3);
+  constants.curve[3] = constant(true, 252, 3);
+  constants.grade[0] = constant(false, 64, 0);
+  constants.grade[1] = constant(false, 65, 0);
+  constants.grade[2] = constant(true, 67, 0);
+  constants.grade[3] = constant(true, 69, 0);
+  for (uint32_t i = 0; i < 3; ++i) {
+    constants.balance[i] = constant(true, 68, i);
+  }
+  constants.balance[3] = float(REXCVAR_GET(mcla_hdr_bloom_gain));
+  // The shoulder: Reinhard extended (the game's, Ld = Ls (1 + Ls / W) / (1 +
+  // Ls)) up to the knee, then an exponential approach to the peak with the
+  // same value there and its slope times the highlights setting. The peak in
+  // the game's units is where the viewing transfer reaches peak / paper white.
+  // Never darker than the game's curve up to its white (Ld 1 at Ls = sqrt(W)):
+  // where the game's curve bends up towards its white (W < 1, by day), the
+  // shoulder bends down from the same slope and would stay under it, so its
+  // slope is at least what reaches 1 at sqrt(W) (the shader also takes the
+  // game's curve where that is higher, below its white). A peak at or below
+  // the game's white leaves no room for a shoulder: the game's curve, clipped
+  // at its white.
+  float knee = float(REXCVAR_GET(mcla_hdr_knee));
+  float b = 1.0f - knee;
+  float ls_knee = (-b + std::sqrt(b * b + 4.0f * knee / white_squared)) * 0.5f * white_squared;
+  float slope = ((1.0f + 2.0f * ls_knee / white_squared) * (1.0f + ls_knee) -
+                 (ls_knee + ls_knee * ls_knee / white_squared)) /
+                ((1.0f + ls_knee) * (1.0f + ls_knee));
+  float peak_relative = state.peak_nits / std::max(state.paper_white_nits, 1.0f);
+  float low = 0.0f, high = 64.0f;
+  for (uint32_t i = 0; i < 32; ++i) {
+    float middle = (low + high) * 0.5f;
+    (HdrSceneViewingTransfer(middle, state.sdr_pure_gamma_2_2) > peak_relative ? high : low) =
+        middle;
+  }
+  float span = std::max(low - knee, 1e-3f);
+  slope *= float(REXCVAR_GET(mcla_hdr_highlights));
+  float white_ls = std::sqrt(white_squared);
+  if (span > b * 1.0001f && white_ls > ls_knee) {
+    slope = std::max(slope, -span * std::log(1.0f - b / span) / (white_ls - ls_knee));
+  }
+  constants.shoulder[0] = knee;
+  constants.shoulder[1] = ls_knee;
+  constants.shoulder[2] = slope;
+  constants.shoulder[3] = span;
+  return HdrSceneCheck::kFound;
+}
+
+float CommandProcessor::HdrSceneViewingTransfer(float value, bool pure_gamma_2_2) const {
+  float code = value > 0.00304f ? 1.055f * std::pow(value, 1.0f / 2.2f) - 0.055f : value * 12.92f;
+  float position = std::max(code, 0.0f) * 255.0f;
+  uint32_t index = uint32_t(std::min(std::floor(position), 254.0f));
+  float low = gamma_ramp_256_entry_table_[index].color_10_green * (1.0f / 1023.0f);
+  float high = gamma_ramp_256_entry_table_[index + 1].color_10_green * (1.0f / 1023.0f);
+  code = std::max(low + (high - low) * (position - float(index)), 0.0f);
+  if (pure_gamma_2_2) {
+    return std::pow(code, 2.2f);
+  }
+  return code > 0.04045f ? std::pow((code + 0.055f) / 1.055f, 2.4f) : code / 12.92f;
+}
+
+bool CommandProcessor::HdrSceneRendered() {
+  hdr_frame_.scene = HdrCopyFromColorTarget(hdr_frame_.scene_target, kHdrTextureTonemap,
+                                            {0, 0, hdr_output_width_, hdr_output_height_}, 0, 0);
+  hdr_frame_.scene_width = hdr_output_width_;
+  hdr_frame_.scene_height = hdr_output_height_;
+  return hdr_frame_.scene;
+}
+
+uint32_t CommandProcessor::HdrColorTargetKey(uint32_t rt_index) const {
+  const RegisterFile& regs = *register_file_;
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[rt_index]);
+  return color_info.GetBaseTiles(HdrEdramTileCount()) | (uint32_t(surface_info.msaa_samples) << 12) |
+         (uint32_t(color_info.color_format) << 14) | (surface_info.surface_pitch << 18);
+}
+
+void CommandProcessor::HdrFail(HdrFailure failure) {
+  if (hdr_frame_.failed) {
+    return;
+  }
+  hdr_frame_.failed = true;
+  uint32_t failure_bit = uint32_t(1) << uint32_t(failure);
+  if (!(hdr_failures_logged_ & failure_bit)) {
+    hdr_failures_logged_ |= failure_bit;
+    static const char* const kReasons[] = {
+        "the UI's render target format", "a blend mode", "a render target copy",
+        "the UI's target resolved elsewhere", "a resolve's place in the front buffer",
+        "the UI layer's texture", "putting the render target back"};
+    static_assert(std::size(kReasons) == size_t(HdrFailure::kCount));
+    REXGPU_INFO(
+        "HDR: separating the UI ended for a frame ({}); frames like it fall back to the "
+        "difference with the underlay, or to the whole frame as SDR",
+        kReasons[uint32_t(failure)]);
+  }
+}
+
+bool CommandProcessor::HdrFrontBufferPosition(uint32_t offset, uint32_t pitch, uint32_t height,
+                                              uint32_t& x, uint32_t& y) {
+  for (const HdrPositionCacheEntry& entry : hdr_position_cache_) {
+    if (entry.pitch == pitch && entry.offset == offset) {
+      x = entry.x;
+      y = entry.y;
+      return true;
+    }
+  }
+  // 32bpp 2D: bases are aligned to 32x32 (xenos::GetTextureTiled*BaseGranularityLog2).
+  for (uint32_t base_y = 0; base_y < height; base_y += 32) {
+    for (uint32_t base_x = 0; base_x < pitch; base_x += 32) {
+      if (uint32_t(texture_util::GetTiledOffset2D(int32_t(base_x), int32_t(base_y), pitch, 2)) ==
+          offset) {
+        hdr_position_cache_[hdr_position_cache_next_++ % std::size(hdr_position_cache_)] = {
+            offset, pitch, base_x, base_y};
+        x = base_x;
+        y = base_y;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool CommandProcessor::HdrBeforeDraw() {
+  hdr_pending_ = HdrPending::kNone;
+  RegisterFile& regs = *register_file_;
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (hdr_frame_.tonemap && !hdr_frame_.ui_begin &&
+      edram_mode == xenos::EdramMode::kColorDepth) {
+    if (!hdr_frame_.scene_checked) {
+      // The tone map phase's draws, up to the tone map's own.
+      HdrSceneCheck check = HdrPrepareScene();
+      if (!hdr_frame_.scene_first_vs && !hdr_frame_.scene_first_ps) {
+        Shader* vertex_shader = active_vertex_shader();
+        Shader* pixel_shader = active_pixel_shader();
+        hdr_frame_.scene_first_vs = vertex_shader ? vertex_shader->ucode_data_hash() : 0;
+        hdr_frame_.scene_first_ps = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+      }
+      if (check != HdrSceneCheck::kNotFound) {
+        hdr_frame_.scene_checked = true;
+        hdr_frame_.scene_check = uint32_t(check);
+        hdr_scene_pending_ = check == HdrSceneCheck::kFound;
+      }
+    } else if (hdr_frame_.scene_target && (regs[XE_GPU_REG_RB_COLOR_MASK] & 0x7) &&
+               HdrColorTargetKey(0) == hdr_frame_.scene_target) {
+      // After the tone map, on its target: light added (the glows), or not.
+      auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+      if (hdr_frame_.glow_additive &&
+          (blend.color_comb_fcn != xenos::BlendOp::kAdd ||
+           blend.color_destblend != xenos::BlendFactor::kOne)) {
+        hdr_frame_.glow_additive = false;
+        hdr_frame_.glow_other_blend = blend.value;
+      }
+    }
+  }
+  if (!hdr_frame_.ui) {
+    return false;
+  }
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    HdrBeforeResolve();
+    return false;
+  }
+  uint32_t color_mask = regs[XE_GPU_REG_RB_COLOR_MASK] & 0xF;
+  if (edram_mode != xenos::EdramMode::kColorDepth || !color_mask) {
+    return false;
+  }
+  uint32_t key = HdrColorTargetKey(0);
+  if (!hdr_frame_.ui_target_drawn) {
+    // The UI's render target is the first one drawn to.
+    hdr_frame_.ui_target_drawn = true;
+    hdr_frame_.ui_target = key;
+    auto format = xenos::ColorRenderTargetFormat((key >> 14) & 0xF);
+    auto msaa = xenos::MsaaSamples((key >> 12) & 3);
+    if (format != xenos::ColorRenderTargetFormat::k_8_8_8_8 || msaa == xenos::MsaaSamples::k2X) {
+      HdrFail(HdrFailure::kFormat);
+    }
+  }
+  if (key != hdr_frame_.ui_target) {
+    return false;
+  }
+  Register blend_register = reg::RB_BLENDCONTROL::rt_register_indices[0];
+  auto blend = regs.Get<reg::RB_BLENDCONTROL>(blend_register);
+  bool opaque = blend.color_srcblend == xenos::BlendFactor::kOne &&
+                blend.color_destblend == xenos::BlendFactor::kZero &&
+                blend.color_comb_fcn == xenos::BlendOp::kAdd;
+  bool over = color_mask == 0xF && blend.color_comb_fcn == xenos::BlendOp::kAdd &&
+              blend.color_destblend == xenos::BlendFactor::kOneMinusSrcAlpha &&
+              (blend.color_srcblend == xenos::BlendFactor::kSrcAlpha ||
+               blend.color_srcblend == xenos::BlendFactor::kOne);
+  if (!hdr_frame_.failed && !hdr_frame_.started && !opaque) {
+    if (over) {
+      hdr_pending_ = HdrPending::kStart;
+    } else {
+      HdrFail(HdrFailure::kBlend);
+    }
+  } else if (!hdr_frame_.failed && hdr_frame_.started && !over) {
+    // Put the target back now, before this draw: a draw may still return
+    // before its render target update.
+    HdrFail(HdrFailure::kBlend);
+    if (!HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_})) {
+      hdr_frame_.snapshot = false;
+    }
+    hdr_frame_.started = false;
+    return false;
+  }
+  if (hdr_frame_.failed) {
+    // For the difference mask: the underlay of this tile.
+    if (!hdr_frame_.snapshot && !opaque) {
+      hdr_pending_ = HdrPending::kSnapshot;
+    }
+    return false;
+  }
+  if (!over) {
+    return false;
+  }
+  // Alpha collects the coverage.
+  hdr_saved_blend_control_ = blend.value;
+  blend.alpha_srcblend = xenos::BlendFactor::kOne;
+  blend.alpha_destblend = xenos::BlendFactor::kOneMinusSrcAlpha;
+  blend.alpha_comb_fcn = xenos::BlendOp::kAdd;
+  regs[blend_register] = blend.value;
+  return true;
+}
+
+void CommandProcessor::HdrRenderTargetsReady() {
+  HdrPending pending = hdr_pending_;
+  hdr_pending_ = HdrPending::kNone;
+  if (pending == HdrPending::kNone) {
+    return;
+  }
+  // The underlay and the clear cover what the output can show.
+  uint32_t key = hdr_frame_.ui_target;
+  HdrRect rect = {0, 0, hdr_output_width_, hdr_output_height_};
+  hdr_frame_.snapshot = HdrCopyFromColorTarget(key, kHdrTextureUnderlayRt, rect, 0, 0);
+  if (pending == HdrPending::kStart) {
+    if (hdr_frame_.snapshot && HdrClearColorTarget(key, rect)) {
+      hdr_frame_.started = true;
+    } else {
+      // No host render target (ROV, FSI) or the copy failed: this draw keeps
+      // the guest's blend (the pipeline isn't configured yet).
+      HdrFail(HdrFailure::kCopy);
+      (*register_file_)[reg::RB_BLENDCONTROL::rt_register_indices[0]] = hdr_saved_blend_control_;
+    }
+  }
+}
+
+void CommandProcessor::HdrBeforeResolve() {
+  const RegisterFile& regs = *register_file_;
+  auto copy_control = regs.Get<reg::RB_COPY_CONTROL>();
+  if (!hdr_frame_.ui_target || copy_control.copy_src_select >= xenos::kMaxColorRenderTargets ||
+      HdrColorTargetKey(copy_control.copy_src_select) != hdr_frame_.ui_target) {
+    return;
+  }
+  // Where the resolved area is in the render target and in the front buffer.
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  draw_util::ResolveInfo info;
+  if (!draw_util::GetResolveInfo(regs, *memory_, scale_x, scale_y, HdrEdramTileCount(), false,
+                                 false, info) ||
+      !info.coordinate_info.width_div_8 || !info.height_div_8) {
+    return;
+  }
+  uint32_t key = hdr_frame_.ui_target;
+  // Only a resolve to a front buffer is the picture. Another one mid-UI ends
+  // the separation (the target is put back first); before the UI, it's the
+  // scene going somewhere else, and doesn't matter.
+  uint32_t front_buffer_height = hdr_output_height_ / scale_y;
+  uint32_t front_buffer_size = hdr_output_width_ / scale_x * front_buffer_height * 4;
+  uint32_t front_buffer = 0;
+  for (uint32_t buffer : hdr_front_buffers_) {
+    if (buffer && info.copy_dest_base - buffer < front_buffer_size) {
+      front_buffer = buffer;
+    }
+  }
+  uint32_t dest_pitch = info.copy_dest_coordinate_info.pitch_aligned_div_32 << 5;
+  uint32_t screen_x = 0, screen_y = 0;
+  HdrFailure failure = HdrFailure::kResolvedElsewhere;
+  if (front_buffer &&
+      xenos::TextureFormat(info.copy_dest_info.copy_dest_format) ==
+          xenos::TextureFormat::k_8_8_8_8 &&
+      !info.copy_dest_info.copy_dest_array) {
+    failure = HdrFailure::kResolveArea;
+    if (HdrFrontBufferPosition(info.copy_dest_base - front_buffer, dest_pitch,
+                               front_buffer_height, screen_x, screen_y)) {
+      screen_x += info.copy_dest_coordinate_info.offset_x_div_8 * 8;
+      screen_y += info.copy_dest_coordinate_info.offset_y_div_8 * 8;
+      failure = HdrFailure::kCount;
+    }
+  }
+  if (failure != HdrFailure::kCount) {
+    if (hdr_frame_.started) {
+      HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_});
+      hdr_frame_.started = false;
+      HdrFail(failure);
+    } else if (hdr_frame_.snapshot && failure == HdrFailure::kResolveArea) {
+      HdrFail(failure);
+    }
+    return;
+  }
+  bool msaa_4x = info.color_edram_info.msaa_samples >= xenos::MsaaSamples::k4X;
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> uint32_t(msaa_4x);
+  uint32_t tile_height =
+      xenos::kEdramTileHeightSamples >>
+      uint32_t(info.color_edram_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  uint32_t base_offset = (info.color_edram_info.GetBaseTiles() - (key & 0xFFF)) &
+                         (HdrEdramTileCount() - 1);
+  uint32_t pitch_tiles = std::max(info.color_edram_info.pitch_tiles, uint32_t(1));
+  uint32_t rt_x = (base_offset % pitch_tiles) * tile_width +
+                  info.coordinate_info.edram_offset_x_div_8 * 8;
+  uint32_t rt_y = (base_offset / pitch_tiles) * tile_height +
+                  info.coordinate_info.edram_offset_y_div_8 * 8;
+  // Both clipped to the textures (the output's size).
+  HdrRect rect = {rt_x * scale_x, rt_y * scale_y, info.coordinate_info.width_div_8 * 8 * scale_x,
+                  info.height_div_8 * 8 * scale_y};
+  uint32_t dest_x = screen_x * scale_x, dest_y = screen_y * scale_y;
+  rect.width = std::min({rect.width, hdr_output_width_ - std::min(dest_x, hdr_output_width_),
+                         hdr_output_width_ - std::min(rect.x, hdr_output_width_)});
+  rect.height = std::min({rect.height, hdr_output_height_ - std::min(dest_y, hdr_output_height_),
+                          hdr_output_height_ - std::min(rect.y, hdr_output_height_)});
+  if (!rect.width || !rect.height) {
+    if (hdr_frame_.started) {
+      HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_});
+      hdr_frame_.started = false;
+    }
+    hdr_frame_.snapshot = false;
+    return;
+  }
+  if (!hdr_frame_.ui_layer_cleared) {
+    hdr_frame_.ui_layer_cleared = true;
+    if (!HdrClearTexture(kHdrTextureUiLayer)) {
+      HdrFail(HdrFailure::kTexture);
+    }
+  }
+  bool copied;
+  if (hdr_frame_.started) {
+    // The UI, the underlay, and the target put back for the resolve.
+    copied = HdrCopyFromColorTarget(key, kHdrTextureUiLayer, rect, dest_x, dest_y) &&
+             HdrCopyTexture(kHdrTextureUnderlayRt, kHdrTextureUnderlay, rect, dest_x, dest_y);
+    if (!HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_})) {
+      HdrFail(HdrFailure::kRestore);
+    }
+  } else if (hdr_frame_.snapshot) {
+    copied = HdrCopyTexture(kHdrTextureUnderlayRt, kHdrTextureUnderlay, rect, dest_x, dest_y);
+  } else {
+    // No UI over this area.
+    copied = HdrCopyFromColorTarget(key, kHdrTextureUnderlay, rect, dest_x, dest_y);
+  }
+  if (copied) {
+    hdr_frame_.captured_area += uint64_t(rect.width) * rect.height;
+  }
+  hdr_frame_.started = false;
+  hdr_frame_.snapshot = false;
+}
