diff --git a/include/rex/cvar.h b/include/rex/cvar.h
index fe94186..73bd347 100644
--- a/include/rex/cvar.h
+++ b/include/rex/cvar.h
@@ -124,7 +124,18 @@ void LoadConfig(const std::filesystem::path& config_path);
