+CommandProcessor::HdrComposite CommandProcessor::HdrGetComposite(uint32_t output_width,
+                                                                 uint32_t output_height) {
+  // The HDR scene only at the size it was made at (the output's size changed
+  // since: the refresher would read past its textures).
+  if (hdr_frame_.scene &&
+      (hdr_frame_.scene_width != output_width || hdr_frame_.scene_height != output_height)) {
+    hdr_frame_.scene = false;
+  }
+  HdrComposite composite = HdrComposite::kWholeFrame;
+  if (hdr_frame_.ui && hdr_frame_.width == output_width && hdr_frame_.height == output_height &&
+      hdr_frame_.captured_area >= uint64_t(output_width) * output_height) {
+    composite = hdr_frame_.failed ? HdrComposite::kMask : HdrComposite::kLayer;
+  } else if (hdr_frame_.tonemap && !hdr_frame_.ui_begin && REXCVAR_GET(hdr_ui_layer) &&
+             ui::Presenter::IsUiSeparationWanted()) {
+    // A frame drawn without a UI pass (one now and then, at transitions).
+    composite = HdrComposite::kScene;
+  }
+  if (composite != hdr_last_composite_) {
+    hdr_last_composite_ = composite;
+    static const char* const kNames[] = {"the front buffer as SDR", "the difference mask",
+                                         "the UI layer", "the front buffer as the scene"};
+    REXGPU_INFO("HDR: frames are put together from {}", kNames[uint32_t(composite)]);
+  }
+  return composite;
+}
+
+void CommandProcessor::HdrRefreshFlags(HdrComposite composite, uint32_t debug_ui,
+                                       uint32_t flags_out[2]) const {
+  // Bits 3:4: 0 the front buffer alone, 1 the difference mask, 2 the UI layer,
+  // 3 a texture shown raw (bits 6:7); bit 5: the UI in magenta; bit 8: the
+  // front buffer alone is the scene; bit 9: the HDR scene is there; bit 10:
+  // shown as the game would (hdr_debug_ui 7). The light added after the tone
+  // map takes the highlights setting only where all of it was added light
+  // (the glows); a frame with other draws there (a flash, a fade, a panel)
+  // keeps its 8-bit difference as it is.
+  float glow_gain =
+      hdr_frame_.glow_additive ? float(REXCVAR_GET(mcla_hdr_highlights)) : 1.0f;
+  std::memcpy(&flags_out[1], &glow_gain, sizeof(float));
+  if (debug_ui >= 3 && debug_ui <= 6) {
+    flags_out[0] = (3u << 3) | ((debug_ui - 3) << 6);
+    return;
+  }
+  if (debug_ui == 2) {
+    flags_out[0] = 0;
+    return;
+  }
+  uint32_t flags = (uint32_t(debug_ui == 1) << 5) | (uint32_t(debug_ui == 7) << 10) |
+                   (uint32_t(debug_ui == 8) << 11);
+  if (hdr_frame_.scene && composite != HdrComposite::kWholeFrame) {
+    flags |= 1u << 9;
+  }
+  flags_out[0] = flags | (composite == HdrComposite::kScene ? 1u << 8 : uint32_t(composite) << 3);
+}
