+// Included within the D3D12TextureCache implementation namespace.
+bool D3D12TextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                                            bool load_mips) {
+  if (!LoadTextureDataRaw(texture, load_base, load_mips)) return false;
+  return !load_base || ExpandReducedScene(texture);
+}
+bool D3D12TextureCache::ExpandReducedScene(Texture& base_texture) {
+  auto& texture = static_cast<D3D12Texture&>(base_texture);
+  const auto key = texture.key();
+  auto found = reduced_scene_pages_.find(key.base_page);
+  if (found == reduced_scene_pages_.end() || key.GetWidth() != 1280 || key.GetHeight() != 720 ||
+      key.mip_max_level || key.depth_or_array_size_minus_1) return true;
+  auto desc = texture.resource()->GetDesc();
+  DXGI_FORMAT format = desc.Format;
+  if (format == DXGI_FORMAT_R16G16B16A16_TYPELESS) format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  if (format == DXGI_FORMAT_R32_TYPELESS) format = DXGI_FORMAT_R32_FLOAT;
+  if (format == DXGI_FORMAT_R8G8B8A8_TYPELESS) format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  uint64_t scratch_key = (uint64_t(format) << 40) | (uint64_t(desc.Width) << 20) | desc.Height;
+  auto& scratch = scene_expand_scratch_[scratch_key];
+  if (!scratch.resource) {
+    desc.Format = format; desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    desc.MipLevels = 1;
+    if (FAILED(command_processor_.GetD3D12Provider().GetDevice()->CreateCommittedResource(
+        &ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE, &desc,
+        D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&scratch.resource)))) return false;
+  }
+  const auto read_state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  command_processor_.PushTransitionBarrier(texture.resource(), texture.SetResourceState(read_state), read_state);
+  if (!command_processor_.FsrResample(texture.resource(), read_state, scratch.resource.Get(),
+      scratch.state, format, uint32_t(std::ceil(desc.Width * found->second)),
+      uint32_t(std::ceil(desc.Height * found->second)), uint32_t(desc.Width), desc.Height)) return false;
+  command_processor_.PushTransitionBarrier(scratch.resource.Get(), scratch.state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  scratch.state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  command_processor_.PushTransitionBarrier(texture.resource(), texture.SetResourceState(D3D12_RESOURCE_STATE_COPY_DEST), D3D12_RESOURCE_STATE_COPY_DEST);
+  command_processor_.SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION dest = {texture.resource(), D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX, {}};
+  D3D12_TEXTURE_COPY_LOCATION source = {scratch.resource.Get(), D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX, {}};
+  command_processor_.GetDeferredCommandList().CopyTexture(dest, source);
+  return true;
+}
