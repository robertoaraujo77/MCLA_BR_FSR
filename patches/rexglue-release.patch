+      ci = std::min(ci + 1, line.size());
+      if (depth == 0) {
+        return {li, ci};
+      }
+    } else if (c == '[' || c == '{') {
+      ++depth;
+      ++ci;
+    } else if (c == ']' || c == '}') {
+      depth = std::max(0, depth - 1);
+      ++ci;
+      if (depth == 0) {
