new file mode 100644
index 0000000..5956c12
--- /dev/null
+++ b/src/graphics/frame_generation_fsr.h
@@ -0,0 +1,26 @@
+/**
+ * Frame generation (rexglue-frame-generation.patch): AMD FSR 3.1's frame
+ * generation from the same FidelityFX runtime as the temporal anti-aliasing
+ * (temporal_aa_fsr.h, cmake/rexglue_fsr.cmake).
+ */
+
+#pragma once
+
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+
+#include <ffx_api/ffx_api.h>
+#include <ffx_api/ffx_framegeneration.h>
+
+namespace rex::graphics {
+
+// What both backends create frame generation with. The prebuilt Vulkan shaders
+// are made for these (launcher/dev/fsr/fsr_vk_shaders.py reads them here). The
+// vectors are the temporal anti-aliasing pass's: at render size, with the
+// jitter already taken out, so neither DISPLAY_RESOLUTION_MOTION_VECTORS nor
+// MOTION_VECTORS_JITTER_CANCELLATION (which, at this FidelityFX commit, only
+// selects other shader permutations); depth is reversed (1 = near).
+constexpr uint32_t kFgCreateFlags = FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED;
+
+}  // namespace rex::graphics
+
+#endif  // REX_HAS_FSR
diff --git a/src/graphics/fsr_modes_vk.h b/src/graphics/fsr_modes_vk.h
new file mode 100644
index 0000000..3aaca41
--- /dev/null
+++ b/src/graphics/fsr_modes_vk.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cstring>
+#include <rex/graphics/vulkan/deferred_command_buffer.h>
+namespace rex::graphics::vulkan {
+// Keep Vulkan operations ordered on the same submission stream as the guest.
+struct FsrModeBlit {
+  PFN_vkCmdBlitImage function;
+  VkImage source, destination;
+  VkImageBlit region;
+  static void Execute(VkCommandBuffer command, const void* data) {
+    FsrModeBlit args;
+    std::memcpy(&args, data, sizeof(args));
+    args.function(command, args.source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                  args.destination, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                  1, &args.region, VK_FILTER_NEAREST);
+  }
+};
+inline void RecordFsrModeBlit(DeferredCommandBuffer& commands, PFN_vkCmdBlitImage function,
+    VkImage source, VkImage destination, uint32_t source_width, uint32_t source_height,
+    uint32_t destination_width, uint32_t destination_height) {
+  FsrModeBlit args{};
+  args.function = function; args.source = source; args.destination = destination;
+  args.region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  args.region.dstSubresource = args.region.srcSubresource;
+  args.region.srcOffsets[1] = {int32_t(source_width), int32_t(source_height), 1};
+  args.region.dstOffsets[1] = {int32_t(destination_width), int32_t(destination_height), 1};
+  commands.CmdExternalCallback(FsrModeBlit::Execute, &args, sizeof(args));
+}
+}
