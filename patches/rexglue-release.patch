+                      " off: none (the default)\n"
+                      " fsr: AMD FSR 3.1 at native resolution (Native AA)")
+    .allowed({"off", "fsr"})
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_STRING(frame_generation_provider, "", "GPU", "Active frame generation provider version (status)");
+REXCVAR_DEFINE_BOOL(frame_generation_menu_available, false, "GPU",
+    "DX12 frame generation runtime is available (status for in-game menu)");
+REXCVAR_DEFINE_STRING(temporal_aa_provider, "3.1", "GPU",
