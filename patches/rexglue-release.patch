+        access_mask = VK_ACCESS_SHADER_READ_BIT;
+        break;
+      case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL:
+        stage_mask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+        access_mask = VK_ACCESS_TRANSFER_READ_BIT;
+        break;
+      case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL:
