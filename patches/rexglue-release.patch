diff --git a/src/graphics/shaders/resolve_direct_full_8bpp.xesli b/src/graphics/shaders/resolve_direct_full_8bpp.xesli
new file mode 100644
index 0000000..fe84630
--- /dev/null
+++ b/src/graphics/shaders/resolve_direct_full_8bpp.xesli
@@ -0,0 +1,60 @@
+/**
