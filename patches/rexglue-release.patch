+/**
+ * Frame generation on Direct3D 12 (rexglue-frame-generation.patch).
+ *
+ * AMD's frame interpolation swap chain (ffx-api's, "the proxy", from
+ * amd_fidelityfx_dx12.dll next to the executable) presents and paces: it has
+ * its own swap chain on a present queue of its own, and threads that present
+ * the generated frame and then the real one, half a frame apart. Everything it
+ * presents is composed by the presenter's present callback, from images of its
+ * own: the real frame from the guest output image (hdr_refresh's HDR10 output,
+ * as without generation), the generated one from its compose (the refresher's
+ * owner, from the generated code values and the frame's UI). The proxy's back
+ * buffers are left unused while generating.
+ *
+ * Per guest frame, on the guest output thread right after the frame's work:
+ * the overlay is copied (the present callback runs later on the proxy's
+ * thread), generation is prepared from the frame's depth and motion vectors,
+ * ffxConfigure gives the frame's ID and the callbacks, and the proxy's Present
+ * runs the generation callback on this thread: frame generation from the
+ * previous frame's HUD-less image to this one's, then the generated frame's
+ * compose, both on the proxy's command list for the game queue. Frame IDs go
+ * up by one at every present through the proxy; paints that don't generate (the
+ * UI thread's, while the guest output thread is silent) turn generation off
+ * and have their back buffer copied.
+ */
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/platform/dynlib.h>
+#include <rex/ui/d3d12/d3d12_presenter.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+
+#if defined(REX_HAS_FRAME_GENERATION_DX12) && REX_HAS_FRAME_GENERATION_DX12
+#include "../../../thirdparty/fsr-redstone/Kits/FidelityFX/api/include/dx12/ffx_api_dx12.h"
+#include "../../../thirdparty/fsr-redstone/Kits/FidelityFX/framegeneration/include/ffx_framegeneration.h"
+#include "../../../thirdparty/fsr-redstone/Kits/FidelityFX/framegeneration/include/dx12/ffx_api_framegeneration_dx12.h"
+#endif
+
+REXCVAR_DECLARE(std::string, frame_generation_present);
+REXCVAR_DECLARE(int32_t, frame_generation_debug);
+REXCVAR_DEFINE_BOOL(frame_generation_timing, false, "GPU",
+                    "Development: logs the GPU time of frame generation and its compose (Direct3D "
+                    "12), every 300 generated frames");
+REXCVAR_DECLARE(int32_t, frame_generation_dump);
+REXCVAR_DECLARE(std::string, frame_generation_dump_path);
+REXCVAR_DEFINE_INT32(frame_generation_edge_pixels, 0, "GPU",
+                    "Use current real-frame pixels at generated-frame boundaries (0 disables)")
+    .range(0, 4);
+
+namespace rex::ui::d3d12 {
+
+#if defined(REX_HAS_FRAME_GENERATION_DX12) && REX_HAS_FRAME_GENERATION_DX12
+
+namespace {
+
+FfxApiResource FfxResource(ID3D12Resource* resource, uint32_t format, uint32_t state) {
+  FfxApiResource result = ffxApiGetResourceDX12(resource, state);
+  result.description.format = format;
+  return result;
+}
+
+void Transition(ID3D12GraphicsCommandList* command_list, ID3D12Resource* resource,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+  if (before == after) {
+    return;
+  }
+  D3D12_RESOURCE_BARRIER barrier = {};
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barrier.Transition.pResource = resource;
+  barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  barrier.Transition.StateBefore = before;
+  barrier.Transition.StateAfter = after;
+  command_list->ResourceBarrier(1, &barrier);
+}
+
+D3D12_RESOURCE_STATES StateFromFfx(uint32_t state) {
+  switch (state) {
+    case FFX_API_RESOURCE_STATE_UNORDERED_ACCESS:
+      return D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    case FFX_API_RESOURCE_STATE_COPY_SRC:
+      return D3D12_RESOURCE_STATE_COPY_SOURCE;
+    case FFX_API_RESOURCE_STATE_COPY_DEST:
+      return D3D12_RESOURCE_STATE_COPY_DEST;
+    case FFX_API_RESOURCE_STATE_RENDER_TARGET:
+      return D3D12_RESOURCE_STATE_RENDER_TARGET;
+    case FFX_API_RESOURCE_STATE_PRESENT:
+      return D3D12_RESOURCE_STATE_PRESENT;
+    default:
+      return D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+             D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  }
+}
+
