+  if (!rt_resource) {
+    return false;
+  }
+  auto* rt = static_cast<D3D12RenderTarget*>(HdrFindColorTarget(key));
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  if (!hdr_restore_root_signature_) {
+    D3D12_DESCRIPTOR_RANGE range = {D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0};
+    D3D12_ROOT_PARAMETER parameter = {};
+    parameter.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameter.DescriptorTable.NumDescriptorRanges = 1;
+    parameter.DescriptorTable.pDescriptorRanges = &range;
+    parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc = {1, &parameter, 0, nullptr,
+                                                     D3D12_ROOT_SIGNATURE_FLAG_NONE};
+    *(hdr_restore_root_signature_.ReleaseAndGetAddressOf()) = ui::d3d12::util::CreateRootSignature(
+        command_processor_.GetD3D12Provider(), root_signature_desc);
+    if (!hdr_restore_root_signature_) {
+      return false;
+    }
+  }
+  Microsoft::WRL::ComPtr<ID3D12PipelineState>& pipeline = hdr_restore_pipelines_[msaa];
+  if (!pipeline) {
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pipeline_desc = {};
+    pipeline_desc.pRootSignature = hdr_restore_root_signature_.Get();
+    pipeline_desc.VS.pShaderBytecode = shaders::hdr_fullscreen_vs;
+    pipeline_desc.VS.BytecodeLength = sizeof(shaders::hdr_fullscreen_vs);
+    pipeline_desc.PS.pShaderBytecode = shaders::hdr_underlay_restore_ps;
+    pipeline_desc.PS.BytecodeLength = sizeof(shaders::hdr_underlay_restore_ps);
+    D3D12_RENDER_TARGET_BLEND_DESC& blend = pipeline_desc.BlendState.RenderTarget[0];
+    blend.BlendEnable = TRUE;
+    blend.SrcBlend = D3D12_BLEND_INV_DEST_ALPHA;
+    blend.DestBlend = D3D12_BLEND_ONE;
+    blend.BlendOp = D3D12_BLEND_OP_ADD;
+    blend.SrcBlendAlpha = D3D12_BLEND_INV_DEST_ALPHA;
+    blend.DestBlendAlpha = D3D12_BLEND_ONE;
+    blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pipeline_desc.SampleMask = UINT_MAX;
+    pipeline_desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pipeline_desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pipeline_desc.RasterizerState.DepthClipEnable = TRUE;
+    pipeline_desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pipeline_desc.NumRenderTargets = 1;
+    pipeline_desc.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pipeline_desc.SampleDesc.Count = rt_resource->GetDesc().SampleDesc.Count;
+    if (FAILED(device->CreateGraphicsPipelineState(&pipeline_desc, IID_PPV_ARGS(&pipeline)))) {
+      return false;
+    }
+  }
+  command_processor_.PushTransitionBarrier(
+      rt_resource, rt->SetResourceState(D3D12_RESOURCE_STATE_RENDER_TARGET),
+      D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  are_current_command_list_render_targets_valid_ = false;
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv = rt->descriptor_draw().GetHandle();
+  command_list.D3DOMSetRenderTargets(1, &rtv, FALSE, nullptr);
+  command_processor_.SetExternalPipeline(pipeline.Get());
+  command_processor_.SetExternalGraphicsRootSignature(hdr_restore_root_signature_.Get());
+  command_list.D3DSetGraphicsRootDescriptorTable(0, underlay_srv);
+  D3D12_RESOURCE_DESC desc = rt_resource->GetDesc();
+  command_processor_.SetViewport({0.0f, 0.0f, float(desc.Width), float(desc.Height), 0.0f, 1.0f});
+  command_processor_.SetScissorRect(rect);
+  command_processor_.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  command_list.D3DDrawInstanced(3, 1, 0, 0);
+  // Back to the guest's render targets in case a draw follows.
+  SetCommandListRenderTargets(last_update_accumulated_render_targets());
+  return true;
+}
