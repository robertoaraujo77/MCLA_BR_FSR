+
+void VulkanCommandProcessor::HdrTransitionImage(HdrImage& image, VkImageLayout layout) {
+  auto usage = [](VkImageLayout image_layout, VkPipelineStageFlags& stage_mask,
+                  VkAccessFlags& access_mask) {
+    switch (image_layout) {
+      case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:
