diff --git a/src/graphics/shaders/fg_hudless_downscale.cs.xesl b/src/graphics/shaders/fg_hudless_downscale.cs.xesl
new file mode 100644
index 0000000..ea7c25a
--- /dev/null
+++ b/src/graphics/shaders/fg_hudless_downscale.cs.xesl
@@ -0,0 +1,51 @@
+// Frame generation (rexglue-frame-generation.patch): the HUD-less image
+// (hdr_refresh_fg.cs.xesl's code values for generation) scaled down to the
+// generation size, the size the real frame is shown at when that is smaller
+// than the guest output: bilinear, at the positions the presenter's bilinear
+// scaling of the real frame samples (pixel centres), so both are scaled alike.
+
+#include "../../ui/shaders/xesl.xesli"
+
+push_const_begin_xe(b0, space0)
+  uint2_xe xe_fg_downscale_source_size;
+  uint2_xe xe_fg_downscale_dest_size;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_fg_downscale_source, set=0, binding=0, t0, space0,
+             texture(0))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgba16f_xe, xe_fg_downscale_dest, set=1,
+              binding=0, u0, space0, texture(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint2_xe dest_size = push_const_xe(xe_fg_downscale_dest_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, dest_size))) {
+    return;
+  }
+  uint2_xe source_size = push_const_xe(xe_fg_downscale_source_size);
+  float2_xe position = max((float2_xe(pixel_index) + 0.5f) * float2_xe(source_size) /
+                               float2_xe(dest_size) -
+                               0.5f,
+                           float2_xe(0.0f, 0.0f));
+  float2_xe position_floor = floor(position);
+  float2_xe fraction = position - position_floor;
+  int2_xe p0 = int2_xe(min(position_floor, float2_xe(source_size) - 1.0f));
+  int2_xe p1 = int2_xe(min(position_floor + 1.0f, float2_xe(source_size) - 1.0f));
+  float4_xe c00 = texel_fetch_2d_xe(xe_fg_downscale_source, p0, 0);
+  float4_xe c10 = texel_fetch_2d_xe(xe_fg_downscale_source, int2_xe(p1.x, p0.y), 0);
+  float4_xe c01 = texel_fetch_2d_xe(xe_fg_downscale_source, int2_xe(p0.x, p1.y), 0);
+  float4_xe c11 = texel_fetch_2d_xe(xe_fg_downscale_source, p1, 0);
+  float4_xe top = c00 + (c10 - c00) * fraction.x;
+  float4_xe bottom = c01 + (c11 - c01) * fraction.x;
+  image_store_2d_rgba_xe(xe_fg_downscale_dest, pixel_index, top + (bottom - top) * fraction.y);
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/fsr_mode_resample_cs.hlsl b/src/graphics/shaders/fsr_mode_resample_cs.hlsl
new file mode 100644
index 0000000..84281c2
--- /dev/null
+++ b/src/graphics/shaders/fsr_mode_resample_cs.hlsl
@@ -0,0 +1,10 @@
+// Nearest resampling of the active FSR input rectangle. No colour conversion.
+cbuffer Size : register(b0) { uint2 source_size; uint2 dest_size; };
+Texture2D<float4> source_image : register(t0);
+RWTexture2D<float4> dest_image : register(u0);
+[numthreads(8,8,1)]
+void main(uint3 p : SV_DispatchThreadID) {
+ if (any(p.xy >= dest_size)) return;
+ uint2 q = min(uint2((float2(p.xy) + 0.5) * float2(source_size) / float2(dest_size)), source_size-1);
+ dest_image[p.xy] = source_image.Load(int3(q,0));
+}
diff --git a/src/graphics/shaders/hdr_fullscreen.vs.xesl b/src/graphics/shaders/hdr_fullscreen.vs.xesl
new file mode 100644
index 0000000..3192b8c
--- /dev/null
+++ b/src/graphics/shaders/hdr_fullscreen.vs.xesl
@@ -0,0 +1,17 @@
+// HDR output (rexglue-hdr-ui-layer.patch): one triangle over the whole
+// viewport, from the vertex index (3 vertices), with the scissor limiting it.
+
+#include "../../ui/shaders/xesl.xesli"
+
+entry_outputs_begin_xe
+  entry_out_position_xe
+entry_outputs_end_stage_inputs_begin_xe
+entry_stage_inputs_end_bindings_begin_vertex_xe
+entry_bindings_end_inputs_begin_xe
+  entry_in_vertex_id_xe
+entry_inputs_end_code_begin_xe
+{
+  float2_xe corner = float2_xe((uint_x2_xe(in_vertex_id_xe) >> uint2_xe(0u, 1u)) & 1u);
+  out_position_xe = float4_xe(corner * 4.0f - 1.0f, 0.0f, 1.0f);
+}
+entry_code_end_xe
diff --git a/src/graphics/shaders/hdr_refresh.cs.xesl b/src/graphics/shaders/hdr_refresh.cs.xesl
new file mode 100644
index 0000000..5d8873f
--- /dev/null
+++ b/src/graphics/shaders/hdr_refresh.cs.xesl
@@ -0,0 +1,334 @@
+// HDR output (rexglue-hdr-output.patch, rexglue-hdr-ui-layer.patch,
+// rexglue-hdr-scene-mcla.patch): the swap's refresher when the presenter's swap
+// chain is HDR10, in place of apply_gamma_table.cs.xesl (its bindings, more
+// constants and textures). SDR values go through the guest's own 256-entry
+// display table, as in SDR (so a game's gamma setting, such as MCLA's DISPLAY
+// GAMMA, works the same), are decoded as SDR content (piecewise sRGB or pure
+// 2.2) and placed in nits, and the result is written as HDR10 code values
+// (BT.2020, PQ) into the guest output image. The table is never applied to PQ
+// values, and the presenter's scaling only reads what this writes.
+// The frame is put together from the front buffer alone (SDR content at the
+// SDR level), or, when the guest's UI was separated
+// (CommandProcessor::HdrFrame), from the UI over the scene: the UI layer
+// (premultiplied, coverage in alpha) over the underlay, blended in code values
+// as the game blends them; or, as the fallback, the front buffer where it
+// differs from the underlay and the underlay elsewhere. With the HDR scene,
+// the scene under the UI comes from it where the 8-bit picture there is the
+// tone map's output plus light the game added after it (the glows, carried
+// over as their 8-bit difference times a gain), as code values of the game's
+// encode extended above 1; the display table and the SDR decode are extended
+// above 1 too, and paper white is where the game's white lands.
+// Frame generation (rexglue-frame-generation.patch, hdr_refresh_fg.cs.xesl,
+// XE_HDR_REFRESH_FG): with flag bit 13, the scene's code values before the UI
+// blend are also written for frame generation (the HUD-less image: times 0.75
+// with a shoulder above 0.8, so they stay below 1 for optical flow's 8-bit
+// luma; alpha 1 where the scene is the HDR scene); with bit 12, a generated
+// frame is composed instead, at the size it was generated at: the scene's code
+// values come from that encoding in the scene texture, under this frame's UI
+// layer (composite 2; its size in flags y, bits 0:15 and 16:31, scaled
+// bilinearly where larger, as the presenter scales the real frame) or no UI. With bit 15, for SDR output:
+// the HUD-less image holds the code values as they are, and a generated frame
+// is written as the SDR refresher writes a frame (the display table at the
+// nearest code); with bit 14, only the HUD-less image is written (the SDR
+// refresher writes the frame itself).
+
+#include "../../ui/shaders/xesl.xesli"
+#include "../../ui/shaders/hdr_output.xesli"
+
+push_const_begin_xe(b0, space0)
+  uint2_xe xe_hdr_refresh_size;
+  // x: bit 0: decode SDR with a pure 2.2 power, else the piecewise sRGB curve;
+  //    bit 1: test pattern in place of the game's frame;
+  //    bit 2: swap red and blue of the source;
+  //    bits 3:4: 0 the front buffer alone, 1 the difference with the underlay,
+  //    2 the UI layer over the underlay, 3 debug, a texture shown raw (bits
+  //    6:7: the UI layer's colour, its alpha, the underlay, the front buffer);
+  //    bit 5: debug, the UI in magenta, and the scene where it isn't from the
+  //    HDR scene (with bit 9) in cyan;
+  //    bit 8: with 0, the front buffer is the scene (a frame without UI);
+  //    bit 9: the HDR scene and the tone map's output are there;
+  //    bit 10: debug, the HDR scene encoded and shown like the game's frame;
+  //    bit 11: debug, the output's HDR10 code values shown as SDR grey levels
+  //    (for measuring it from a capture).
+  // y: the light glows' gain (float).
+  uint2_xe xe_hdr_refresh_flags;
+  // x: SDR content white, y: paper white, z: roll-off start, w: peak (nits).
+  float4_xe xe_hdr_refresh_levels;
+push_const_end_xe
+
+#ifdef XE_HDR_REFRESH_FG
+// Code values to frame generation's input: 0.75 times, and a rational shoulder
+// above 0.8 that approaches 1 without reaching it.
+float3_xe XeHdrRefreshFgEncode(float3_xe code, bool sdr) {
+  dont_flatten_xe if (sdr) {
+    return max(code, XeHdrSplat(0.0f));
+  }
+  float3_xe v = max(code, XeHdrSplat(0.0f)) * 0.75f;
+  float3_xe x = max(v - 0.8f, XeHdrSplat(0.0f));
+  return select_xe(greater_than_xe(v, XeHdrSplat(0.8f)), 0.8f + 0.2f * x / (x + 0.2f), v);
+}
+// Its inverse.
+float3_xe XeHdrRefreshFgDecode(float3_xe v, bool sdr) {
+  v = max(v, XeHdrSplat(0.0f));
+  dont_flatten_xe if (sdr) {
+    return v;
+  }
+  float3_xe y = min(v - 0.8f, XeHdrSplat(0.1999f));
+  float3_xe x = 0.2f * y / (0.2f - y);
+  return select_xe(greater_than_xe(v, XeHdrSplat(0.8f)), 0.8f + x, v) * (1.0f / 0.75f);
+}
+#endif
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+// The front buffer at a pixel, red and blue swapped if needed.
+#define XeHdrRefreshSource(pixel, flags)                                         \
+  ((((flags) & 4u) != 0u)                                                        \
+       ? texel_fetch_2d_xe(xe_hdr_refresh_source, pixel, 0).bgr                  \
+       : texel_fetch_2d_xe(xe_hdr_refresh_source, pixel, 0).rgb)
+// Whether the front buffer differs from the underlay row_offset rows away.
+#define XeHdrRefreshDiffers(pixel, row_offset, flags)                            \
+  any(greater_than_xe(                                                           \
+      abs(XeHdrRefreshSource(pixel + int2_xe(0, row_offset), flags) -            \
+          texel_fetch_2d_xe(xe_hdr_refresh_underlay,                             \
+                            pixel + int2_xe(0, row_offset), 0).rgb),             \
+      XeHdrSplat(0.5f / 255.0f)))
+// The display table (blue in bits 0:9, green in 10:19, red in 20:29 - BGR
+// passed as an R10G10B10A2 buffer) at a code for each channel.
+#define XeHdrRefreshTable(codes)                                                 \
+  float3_xe(texel_fetch_buffer_xe(xe_hdr_refresh_ramp, (codes).r).b,            \
+            texel_fetch_buffer_xe(xe_hdr_refresh_ramp, (codes).g).g,            \
+            texel_fetch_buffer_xe(xe_hdr_refresh_ramp, (codes).b).r)
+// An SDR colour through the display table (at the nearest code), as linear
+// light relative to SDR white.
+#define XeHdrRefreshSdr(color, flags)                                            \
+  XeHdrSdrToLinear(XeHdrRefreshTable(uint3_xe(saturate_xe(color) * 255.0f + 0.5f)), \
+                   ((flags) & 1u) != 0u)
+
+// MCLA's encode (1.055 x^(1/2.2) - 0.055, 12.92 x near black), extended above 1.
+float3_xe XeHdrRefreshGameEncode(float3_xe linear_value) {
+  linear_value = max(linear_value, XeHdrSplat(0.0f));
+  return select_xe(greater_than_xe(linear_value, XeHdrSplat(0.00304f)),
+                   1.055f * pow(linear_value, XeHdrSplat(1.0f / 2.2f)) - 0.055f,
+                   linear_value * 12.92f);
+}
+
+float3_xe XeHdrRefreshGameDecode(float3_xe code) {
+  return select_xe(greater_than_xe(code, XeHdrSplat(0.00304f * 12.92f)),
+                   pow((code + 0.055f) * (1.0f / 1.055f), XeHdrSplat(2.2f)),
+                   code * (1.0f / 12.92f));
+}
+
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_buffer_xe, xe_hdr_refresh_ramp, set=0, binding=0, t0,
+             space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_source, set=1, binding=0, t1,
+             space0, texture(1))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgb10_a2_xe, xe_hdr_refresh_dest,
+              set=2, binding=0, u0, space0, texture(2))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_underlay, set=3, binding=0, t2,
+             space0, texture(3))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_ui_layer, set=3, binding=1, t3,
+             space0, texture(4))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_scene, set=3, binding=2, t4,
+             space0, texture(5))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_tonemap, set=3, binding=3, t5,
+             space0, texture(6))
+#ifdef XE_HDR_REFRESH_FG
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgba16f_xe, xe_hdr_refresh_hudless,
+              set=4, binding=0, u1, space0, texture(7))
+#endif
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint2_xe size = push_const_xe(xe_hdr_refresh_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, size))) {
+    return;
+  }
+  int2_xe pixel = int2_xe(pixel_index);
+  uint flags = push_const_xe(xe_hdr_refresh_flags).x;
+  uint composite = (flags >> 3u) & 3u;
+  float4_xe levels = push_const_xe(xe_hdr_refresh_levels);
+  float3_xe magenta = float3_xe(1.0f, 0.0f, 1.0f);
+
+  float3_xe nits;
+  dont_flatten_xe if (composite == 3u) {
+    // Debug: a texture's values shown as SDR codes: the UI layer's colour, its
+    // alpha, the underlay or the front buffer (bits 6:7).
+    uint shown = (flags >> 6u) & 3u;
+    float4_xe texel = shown == 2u ? texel_fetch_2d_xe(xe_hdr_refresh_underlay, pixel, 0)
+                                  : texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, pixel, 0);
+    dont_flatten_xe if (shown == 3u) {
+      texel.rgb = XeHdrRefreshSource(pixel, flags);
+    }
+    nits = XeHdrSdrToLinear(shown == 1u ? texel.aaa : texel.rgb, (flags & 1u) != 0u) * levels.x;
+  } else {
+    // The UI (premultiplied code values, coverage in alpha) and the 8-bit
+    // picture of the scene under it.
+    float3_xe ui_code;
+    float ui_alpha;
+    float3_xe scene_sdr;
+    dont_flatten_xe if (composite == 2u) {
+      float4_xe ui = texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, pixel, 0);
+#ifdef XE_HDR_REFRESH_FG
+      dont_flatten_xe if ((flags & 4096u) != 0u) {
+        // A generated frame, at its size.
+        uint2_xe ui_size = uint2_xe(push_const_xe(xe_hdr_refresh_flags).y & 0xFFFFu,
+                                    push_const_xe(xe_hdr_refresh_flags).y >> 16u);
+        dont_flatten_xe if (any(not_equal_xe(ui_size, size))) {
+          // At the presenter's bilinear sample positions (pixel centres).
+          float2_xe position = max((float2_xe(pixel_index) + 0.5f) * float2_xe(ui_size) /
+                                       float2_xe(size) -
+                                       0.5f,
+                                   float2_xe(0.0f, 0.0f));
+          float2_xe position_floor = floor(position);
+          float2_xe fraction = position - position_floor;
+          int2_xe p0 = int2_xe(min(position_floor, float2_xe(ui_size) - 1.0f));
+          int2_xe p1 = int2_xe(min(position_floor + 1.0f, float2_xe(ui_size) - 1.0f));
+          float4_xe c00 = texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, p0, 0);
+          float4_xe c10 = texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, int2_xe(p1.x, p0.y), 0);
+          float4_xe c01 = texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, int2_xe(p0.x, p1.y), 0);
+          float4_xe c11 = texel_fetch_2d_xe(xe_hdr_refresh_ui_layer, p1, 0);
+          float4_xe top = c00 + (c10 - c00) * fraction.x;
+          float4_xe bottom = c01 + (c11 - c01) * fraction.x;
+          ui = top + (bottom - top) * fraction.y;
+        }
+      }
+#endif
+      ui_alpha = ui.a;
+      ui_code = (flags & 32u) != 0u ? magenta * ui.a : ui.rgb;
+      scene_sdr = texel_fetch_2d_xe(xe_hdr_refresh_underlay, pixel, 0).rgb;
+    } else {
+      float3_xe source = XeHdrRefreshSource(pixel, flags);
+      // In the fallback, the UI is where the front buffer differs from the
+      // underlay, and so does it in the row above or below: single rows that
+      // differ are the seams of a tiled UI pass and the top row, not UI (at a
+      // scaled resolution, UI is at least as tall as the scale).
+      bool ui = (flags & 256u) == 0u;
+      scene_sdr = source;
+      dont_flatten_xe if (composite == 1u) {
+        ui = XeHdrRefreshDiffers(pixel, 0, flags) &&
+             ((pixel_index.y > 0u && XeHdrRefreshDiffers(pixel, -1, flags)) ||
+              (pixel_index.y + 1u < size.y && XeHdrRefreshDiffers(pixel, 1, flags)));
+        scene_sdr = texel_fetch_2d_xe(xe_hdr_refresh_underlay, pixel, 0).rgb;
+      }
+      ui_alpha = ui ? 1.0f : 0.0f;
+      ui_code = ui ? ((flags & 32u) != 0u && composite == 1u ? magenta : source)
+                   : XeHdrSplat(0.0f);
+    }
+    // The scene's code values: from the HDR scene where the 8-bit picture is
+    // the tone map's output, or brighter by light added on top of it (anything
+    // darker was drawn over it); otherwise the 8-bit picture.
+    float3_xe scene_code = scene_sdr;
+    bool scene_hdr = false;
+#ifdef XE_HDR_REFRESH_FG
+    dont_flatten_xe if ((flags & 4096u) != 0u) {
+      // A generated frame's scene (its alpha is frame generation's): the
+      // table between codes where this frame has the HDR scene.
+      scene_code = XeHdrRefreshFgDecode(texel_fetch_2d_xe(xe_hdr_refresh_scene, pixel, 0).rgb,
+                                        (flags & 32768u) != 0u);
+      scene_hdr = (flags & (512u | 1024u)) == 512u;
+    } else
+#endif
+    dont_flatten_xe if (ui_alpha < 1.0f && (flags & 512u) != 0u) {
+      float tonemap_tolerance = 1.5f / 255.0f;
+      float3_xe tonemap = texel_fetch_2d_xe(xe_hdr_refresh_tonemap, pixel, 0).rgb;
+      dont_flatten_xe if (all(greater_than_equal_xe(scene_sdr, tonemap - tonemap_tolerance))) {
+        float3_xe glow = select_xe(
+            greater_than_xe(scene_sdr - tonemap, XeHdrSplat(tonemap_tolerance)),
+            XeHdrRefreshGameDecode(scene_sdr) - XeHdrRefreshGameDecode(tonemap),
+            XeHdrSplat(0.0f));
+        scene_code = XeHdrRefreshGameEncode(
+            texel_fetch_2d_xe(xe_hdr_refresh_scene, pixel, 0).rgb +
+            glow * uint_bits_to_float_xe(push_const_xe(xe_hdr_refresh_flags).y));
+        scene_hdr = (flags & 1024u) == 0u;
+      } else dont_flatten_xe if ((flags & 32u) != 0u) {
+        scene_code = float3_xe(0.0f, 1.0f, 1.0f);
+      }
+    }
+#ifdef XE_HDR_REFRESH_FG
+    dont_flatten_xe if ((flags & 8192u) != 0u) {
+      image_store_2d_rgba_xe(
+          xe_hdr_refresh_hudless, pixel_index,
+          float4_xe(XeHdrRefreshFgEncode(scene_code, (flags & 32768u) != 0u),
+                    scene_hdr ? 1.0f : 0.0f));
+      dont_flatten_xe if ((flags & 16384u) != 0u) {
+        return;
+      }
+    }
+#endif
+    // Blended as the game blends its UI: in its code values, before the
+    // display table; then the table (between codes, and along its last step
+    // above 1, for the HDR scene) and the SDR decode, at paper white.
+    float3_xe code = ui_code + scene_code * (1.0f - ui_alpha);
+#ifdef XE_HDR_REFRESH_FG
+    dont_flatten_xe if ((flags & 32768u) != 0u) {
+      // SDR output, as apply_gamma_table.cs writes it.
+      image_store_2d_rgba_xe(
+          xe_hdr_refresh_dest, pixel_index,
+          float4_xe(XeHdrRefreshTable(uint3_xe(saturate_xe(code) * 255.0f + 0.5f)), 1.0f));
+      return;
+    }
+#endif
+    float3_xe relative;
+    dont_flatten_xe if (scene_hdr) {
+      float3_xe position = max(code, XeHdrSplat(0.0f)) * 255.0f;
+      // Never NaN as the table's index (checked by the bits: a compiler may
+      // fold x == x).
+      position = select_xe(
+          less_than_equal_xe(float_bits_to_uint_xe(position) & 0x7FFFFFFFu,
+                             uint3_xe(0x7F800000u, 0x7F800000u, 0x7F800000u)),
+          position, XeHdrSplat(0.0f));
+      uint3_xe index = uint3_xe(min(floor(position), XeHdrSplat(254.0f)));
+      float3_xe low = XeHdrRefreshTable(index);
+      relative = XeHdrSdrToLinear(
+          low + (XeHdrRefreshTable(index + 1u) - low) * (position - float3_xe(index)),
+          (flags & 1u) != 0u);
+    } else {
+      relative = XeHdrRefreshSdr(code, flags);
+    }
+    // SDR content white (hdr_ui_nits) other than paper white: the UI's share
+    // moves to its level. Everything at it for the debug views.
+    float paper_white = (flags & 1024u) != 0u ? levels.x : levels.y;
+    nits = relative * paper_white;
+    dont_flatten_xe if (ui_alpha > 0.0f && levels.x != paper_white) {
+      nits += XeHdrRefreshSdr(ui_code / ui_alpha, flags) * (ui_alpha * (levels.x - paper_white));
+    }
+  }
+
+  dont_flatten_xe if ((flags & 2u) != 0u) {
+    // Test pattern. Top half: 24 bars from 100 nits doubling every 4 bars
+    // (100, 200, 400, 800, 1600, 3200 nits at bars 0, 4, 8, 12, 16, 20), not
+    // rolled off, for where the display itself stops showing steps. Bottom
+    // half: paper white on the left, the same bars rolled off towards the
+    // peak setting on the right.
+    float2_xe position = (float2_xe(pixel_index) + 0.5f) / float2_xe(size);
+    bool top = position.y < 0.5f;
+    float bar_position = top ? position.x : position.x * 2.0f - 1.0f;
+    float bar_nits = 100.0f * exp2(floor(bar_position * 24.0f) * 0.25f);
+    nits = XeHdrSplat(top ? bar_nits
+                          : (bar_position < 0.0f ? levels.y : bar_nits));
+    dont_flatten_xe if (top) {
+      levels.z = 10000.0f;
+    }
+  }
+
+  nits = XeHdrRollOff(nits, levels.z, levels.w);
+  float3_xe pq = XeHdrEncodePq(nits);
+  dont_flatten_xe if ((flags & 2048u) != 0u) {
+    pq = XeHdrEncodePq(XeHdrSdrToLinear(pq, (flags & 1u) != 0u) * levels.x);
+  }
+  image_store_2d_rgba_xe(xe_hdr_refresh_dest, pixel_index, float4_xe(pq, 1.0f));
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/hdr_refresh_fg.cs.xesl b/src/graphics/shaders/hdr_refresh_fg.cs.xesl
