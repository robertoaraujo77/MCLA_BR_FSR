+void D3D12Presenter::CreateUIOverlayFromUIThread(uint32_t width, uint32_t height) {
+  if (ui_overlay_.layers[0] && ui_overlay_.width == width && ui_overlay_.height == height) {
+    return;
+  }
+  DestroyUIOverlayFromUIThread();
+  ID3D12Device* device = provider_.GetDevice();
+  if (!ui_overlay_.command_list) {
+    for (Microsoft::WRL::ComPtr<ID3D12CommandAllocator>& allocator :
+         ui_overlay_.command_allocators) {
+      if (FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                IID_PPV_ARGS(&allocator)))) {
+        REXLOG_ERROR("D3D12Presenter: Failed to create a UI overlay command allocator");
+        return;
+      }
+    }
+    if (FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                         ui_overlay_.command_allocators[0].Get(), nullptr,
+                                         IID_PPV_ARGS(&ui_overlay_.command_list)))) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create the UI overlay command list");
+      return;
+    }
+    ui_overlay_.command_list->Close();
+    D3D12_DESCRIPTOR_HEAP_DESC rtv_heap_desc = {};
+    rtv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    rtv_heap_desc.NumDescriptors = UIOverlay::kLayerCount;
+    if (FAILED(device->CreateDescriptorHeap(&rtv_heap_desc, IID_PPV_ARGS(&ui_overlay_.rtv_heap)))) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create the UI overlay RTV heap");
+      ui_overlay_.command_list.Reset();
+      return;
+    }
+  }
+  D3D12_RESOURCE_DESC layer_desc = {};
+  layer_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  layer_desc.Width = width;
+  layer_desc.Height = height;
+  layer_desc.DepthOrArraySize = 1;
+  layer_desc.MipLevels = 1;
+  layer_desc.Format = kSwapChainFormat;
+  layer_desc.SampleDesc.Count = 1;
+  layer_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  layer_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+  D3D12_CLEAR_VALUE clear_value = {};
+  clear_value.Format = kSwapChainFormat;
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv_start = ui_overlay_.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  for (uint32_t i = 0; i < UIOverlay::kLayerCount; ++i) {
+    if (FAILED(device->CreateCommittedResource(
+            &util::kHeapPropertiesDefault, provider_.GetHeapFlagCreateNotZeroed(), &layer_desc,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, &clear_value,
+            IID_PPV_ARGS(&ui_overlay_.layers[i])))) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create a UI overlay layer");
+      DestroyUIOverlayFromUIThread();
+      return;
+    }
+    device->CreateRenderTargetView(ui_overlay_.layers[i].Get(), nullptr,
+                                   provider_.OffsetRTVDescriptor(rtv_start, i));
+    device->CreateShaderResourceView(
+        ui_overlay_.layers[i].Get(), nullptr,
+        provider_.OffsetViewDescriptor(
+            paint_context_.view_heap->GetCPUDescriptorHandleForHeapStart(),
+            PaintContext::kViewIndexUiOverlay0Srv + i));
+  }
+  ui_overlay_.width = width;
+  ui_overlay_.height = height;
+  ui_overlay_.next_layer = 0;
+}
+
+void D3D12Presenter::DestroyUIOverlayFromUIThread() {
+  // Painting (which copies from the layers) isn't running while the UI thread
+  // manages the connection; the UI thread's own drawing into them must end.
+  ui_submission_tracker_.AwaitAllSubmissionsCompletion();
+  ui_overlay_published_.store(UINT32_MAX, std::memory_order_release);
+  for (Microsoft::WRL::ComPtr<ID3D12Resource>& layer : ui_overlay_.layers) {
+    layer.Reset();
+  }
+  ui_overlay_.width = 0;
+  ui_overlay_.height = 0;
+}
